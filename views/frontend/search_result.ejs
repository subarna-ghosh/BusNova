<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BusNova — Search Results</title>

    <!-- Bootstrap CSS & Icons (From original code) -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=Roboto:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- FontAwesome (For Search Results Icons) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/assets/css/search_result.css">
  </head>
  <body>
    <!-- ORIGINAL NAVBAR -->
    <%- include('../layouts/frontend_navbar') %>

    <!-- SEARCH BAR -->
    <div class="search-wrapper">
      <form class="search-form" onsubmit="event.preventDefault()">
        <div class="search-input-group">
          <label for="fromCity">From</label>
          <select id="fromCity">
            <option value="kolkata" selected>Kolkata</option>
            <option value="puri">Puri</option>
            <option value="digha">Digha</option>
            <option value="bhubaneswar">Bhubaneswar</option>
            <option value="siliguri">Siliguri</option>
          </select>
          <i class="fa-solid fa-chevron-down dropdown-icon"></i>
        </div>

        <div class="search-input-group">
          <label for="toCity">To</label>
          <select id="toCity">
            <option value="puri" selected>Puri</option>
            <option value="kolkata">Kolkata</option>
            <option value="digha">Digha</option>
            <option value="bhubaneswar">Bhubaneswar</option>
            <option value="siliguri">Siliguri</option>
          </select>
          <i class="fa-solid fa-chevron-down dropdown-icon"></i>
        </div>

        <div class="search-input-group">
          <label for="departDate">Depart Date</label>
          <input type="date" id="departDate" value="2026-07-24" />
        </div>

        <div class="search-input-group">
          <label for="returnDate">Return Date</label>
          <input type="date" id="returnDate" />
        </div>

        <button type="submit" class="btn-search">Search</button>
      </form>
    </div>

    <!-- SEARCH RESULTS LIST -->
    <div class="results-container">
      <div class="results-header">
        <div>Coach</div>
        <div>Service</div>
        <div>Bus Type</div>
        <div>Departure <i class="fa-solid fa-arrow-up"></i></div>
        <div>Duration</div>
        <div>Arrival</div>
        <div>Available Seat</div>
        <div>Fare</div>
      </div>

      <!-- BUS ROW 1 -->
      <div class="bus-row">
        <div>
          <div class="bus-img-placeholder">
            <i class="fa-solid fa-bus-simple fa-2x"></i>
          </div>
        </div>
        <div>
          <div class="service-code">KP-1107</div>
          <div class="icon-bar">
            <i class="fa-solid fa-info-circle"></i>
            <i class="fa-solid fa-mobile-screen"></i>
            <i class="fa-solid fa-plug"></i>
            <span style="font-weight: bold; color: #007bff">+12</span>
          </div>
        </div>
        <div>
          <div class="bus-title">
            <i class="fa-solid fa-bus" style="color: #007bff"></i>
            2+1, VOLVO MULTI AXLE
          </div>
          <div class="sub-text">B11R SEATER/ SLEEPER (2+1), AC (58 seats)</div>
        </div>
        <div>
          <div class="time-large">
            <i class="fa-regular fa-clock"></i> 20:00
          </div>
          <div class="sub-text">Fri, 24 Jul</div>
          <a href="#" class="point-link">Boarding Points</a>
        </div>
        <div class="duration-arrow">
          <i class="fa-solid fa-arrow-right"></i>
          <div>10h 00m Hrs</div>
        </div>
        <div>
          <div class="time-large">
            <i class="fa-regular fa-clock"></i> 06:00
          </div>
          <div class="sub-text">Sat, 25 Jul</div>
          <a href="#" class="point-link">Dropping Points</a>
        </div>
        <div class="seats-count">
          <div>0</div>
          <div class="sub-text">Seats available</div>
        </div>
        <div>
          <div class="fare-price">₹ 1852/-</div>
          <div class="sold-out-text">Sold Out!</div>
        </div>
      </div>

      <!-- BUS ROW 2 -->
      <div class="bus-row">
        <div>
          <div class="bus-img-placeholder">
            <i class="fa-solid fa-bus-simple fa-2x"></i>
          </div>
        </div>
        <div>
          <div class="service-code">KP-1101 special</div>
          <div class="icon-bar">
            <i class="fa-solid fa-info-circle"></i>
            <i class="fa-solid fa-mobile-screen"></i>
            <i class="fa-solid fa-plug"></i>
            <span style="font-weight: bold; color: #007bff">+12</span>
          </div>
        </div>
        <div>
          <div class="bus-title">
            <i class="fa-solid fa-bus" style="color: #007bff"></i>
            2+1, VOLVO MULTI AXLE
          </div>
          <div class="sub-text">B11R SEATER/ SLEEPER (2+1), AC (58 seats)</div>
        </div>
        <div>
          <div class="time-large">
            <i class="fa-regular fa-clock"></i> 20:30
          </div>
          <div class="sub-text">Fri, 24 Jul</div>
          <a href="#" class="point-link">Boarding Points</a>
        </div>
        <div class="duration-arrow">
          <i class="fa-solid fa-arrow-right"></i>
          <div>10h 30m Hrs</div>
        </div>
        <div>
          <div class="time-large">
            <i class="fa-regular fa-clock"></i> 07:00
          </div>
          <div class="sub-text">Sat, 25 Jul</div>
          <a href="#" class="point-link">Dropping Points</a>
        </div>
        <div class="seats-count">
          <div>31</div>
          <div class="sub-text">Seats available</div>
        </div>
        <div>
          <div class="fare-price">₹ 1540/-</div>
          <button class="btn-view-seats">VIEW SEATS</button>
        </div>
      </div>
    </div>

    <!-- WHATSAPP FLOATING BUTTON -->
    <a href="#" class="whatsapp-btn">
      <i class="fa-brands fa-whatsapp"></i>
    </a>

    <!--FOOTER -->
    <%- include('../layouts/frontend_footer') %>

    <!-- Bootstrap JS (Needed for Navbar Toggler) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
