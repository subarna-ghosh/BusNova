<header class="admin-topbar">
  <button class="icon-btn d-lg-none" id="sidebarToggle" aria-label="Open menu">
    <i class="bi bi-list"></i>
  </button>

  <div class="topbar-search">
    <i class="bi bi-search"></i>
    <input type="text" placeholder="Search your bookings, routes…" />
  </div>

  <div class="topbar-actions">
    <!-- Notifications -->
    <button
      class="icon-btn"
      aria-label="Notifications"
      data-bs-toggle="dropdown"
    >
      <i class="bi bi-bell"></i>

      <span class="icon-dot" id="notificationDot" style="display: none"></span>
    </button>

    <ul
      class="dropdown-menu dropdown-menu-end notif-menu"
      id="notificationMenu"
    >
      <% if (notifications && notifications.length > 0) { %>
        <% notifications.forEach(notification => { %>
          <li class="notif-item">
            <i class="bi bi-bell text-brand"></i>
            <div>
              <strong>
                <%= notification.title %>
              </strong>
              <span>
                <%= notification.message %>
              </span>
            </div>
          </li>
        <% }) %>
     <% } else { %>
        <li class="notif-item" id="noNotificationItem">
          <i class="bi bi-bell text-brand"></i>
          <div>
            <strong>No new notifications</strong>
            <span>You're all caught up.</span>
          </div>
        </li>

     <% } %>
    </ul>
    <!-- Account -->
    <div class="dropdown">
      <button
        class="admin-profile"
        data-bs-toggle="dropdown"
        aria-label="Account menu"
      >
        <span class="avatar-initials">
          <%= username .split(" ") .map(word => word.charAt(0)) .join("")
          .toUpperCase() %>
        </span>
        <span class="d-none d-md-inline"> <%= username %> </span>
        <i class="bi bi-chevron-down small"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <a class="dropdown-item" href="/web/customer/view/dashboard">
            <i class="bi bi-person me-2"></i>
            My profile
          </a>
        </li>
        <li>
          <a class="dropdown-item" href="#">
            <i class="bi bi-gear me-2"></i>
            Account settings
          </a>
        </li>
        <li>
          <hr class="dropdown-divider" />
        </li>
        <li>
          <a class="dropdown-item" href="/web/auth/logout">
            <i class="bi bi-box-arrow-right me-2"></i>
            Sign out
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>
