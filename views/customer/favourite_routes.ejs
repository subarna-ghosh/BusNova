<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />
  <title>BusNova — Favorite Routes</title>
  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />
  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
  <!-- Dashboard CSS -->
  <link
    rel="stylesheet"
    href="/assets/css/admin_dashboard.css"
  />
  <link
    rel="stylesheet"
    href="/assets/css/customer_dashboard.css"
  />
</head>
<body>
  <!-- Sidebar Backdrop -->

  <div
    class="sidebar-backdrop"
    id="sidebarBackdrop"
  ></div>
  <!-- Sidebar -->
  <%- include('../layouts/customer_sidebar') %>
  <div class="admin-main">
    <!-- Navbar -->
    <%- include('../layouts/customer_navbar') %>
    <main class="admin-content">
      <section class="admin-page">

        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="page-head">
          <div>
            <h1>
              Favorite Routes
            </h1>
            <p>
              Your most frequently booked routes.
            </p>
          </div>
        </div>

        <!-- =========================================
             ROUTES
        ========================================== -->

        <% if (
          favouriteRoutes &&
          favouriteRoutes.length > 0
        ) { %>

          <div
            class="row g-3"
            id="favoriteRoutesGrid"
          >
            <% favouriteRoutes.forEach((route) => { %>
              <div
                class="col-md-6 col-lg-4"
              >
                <div class="route-card h-100">
                  <!-- HEART -->

                  <div
                    class="d-flex justify-content-end mb-2"
                  >

                    <i
                      class="bi bi-heart-fill text-danger fs-5"
                      title="Frequently booked route"
                    ></i>

                  </div>


                  <!-- ROUTE -->

                  <div class="route-path">

                    <span>

                      <%= route.origin?.city ||
                          route.origin?.name ||
                          "Origin" %>

                    </span>


                    <i
                      class="bi bi-arrow-right"
                    ></i>


                    <span>

                      <%= route.destination?.city ||
                          route.destination?.name ||
                          "Destination" %>

                    </span>

                  </div>


                  <!-- META -->

                  <div
                    class="route-meta mt-2"
                  >

                    <i
                      class="bi bi-ticket-perforated me-1"
                    ></i>

                    Booked

                    <strong>
                      <%= route.bookingCount %>
                    </strong>

                    <%= route.bookingCount === 1
                        ? "time"
                        : "times" %>


                    <% if (
                      route.lowestFare != null
                    ) { %>

                      <span class="mx-1">
                        ·
                      </span>

                      From

                      <strong>
                        ₹<%= route.lowestFare %>
                      </strong>

                    <% } %>

                  </div>


                  <!-- BOOK AGAIN -->

                  <a
                    href="/web/search/view/result?originStopId=<%= route.origin?._id %>&destinationStopId=<%= route.destination?._id %>"
                    class="btn btn-outline-brand w-100 mt-3"
                  >

                    <i
                      class="bi bi-search me-1"
                    ></i>

                    Find Buses

                  </a>


                </div>

              </div>


            <% }) %>


          </div>


        <% } else { %>


          <!-- =========================================
               EMPTY STATE
          ========================================== -->

          <div class="panel">

            <div
              class="text-center py-5"
            >

              <div class="mb-3">

                <i
                  class="bi bi-heart fs-1 text-muted"
                ></i>

              </div>


              <h4>
                No favorite routes yet
              </h4>


              <p class="text-muted mb-4">

                Once you book a few trips,
                your frequently travelled routes
                will appear here.

              </p>


              <a
                href="/web/home/view/landing/page"
                class="btn btn-brand"
              >

                <i
                  class="bi bi-bus-front me-1"
                ></i>

                Find a Bus

              </a>

            </div>

          </div>


        <% } %>


      </section>

    </main>

  </div>


  <!-- Bootstrap JS -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>


  <!-- Customer Dashboard JS -->

  <script
    src="/assets/js/customer_dashboard.js"
  ></script>

</body>

</html>