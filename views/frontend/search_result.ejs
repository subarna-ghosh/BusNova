<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BusNova — Search Results</title>

    <!-- Bootstrap CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/assets/css/search_result.css" />
  </head>
  <body>
    <!-- NAVBAR -->
    <%- include('../layouts/frontend_navbar') %>

    <!-- SEARCH BAR FORM -->
    <div class="search-wrapper">
      <form class="search-form" action="/web/search/view/result" method="GET" id="searchFilterForm">
        <div class="search-input-group">
          <label for="fromCity">From</label>
          <select id="fromCity" name="from">
            <% if (typeof destination !== 'undefined' && destination.length > 0) { %>
              <% destination.forEach((o) => { %>
                <option value="<%= o.originStop._id %>" <%= queryParams && queryParams.from == o.originStop._id ? 'selected' : '' %>>
                  <%= o.originStop.city %>
                </option>
              <% }) %>
            <% } %>
          </select>
          <i class="fa-solid fa-chevron-down dropdown-icon"></i>
        </div>

        <div class="search-input-group">
          <label for="toCity">To</label>
          <select id="toCity" name="to">
            <% if (typeof destination !== 'undefined' && destination.length > 0) { %>
              <% destination.forEach((d) => { %>
                <option value="<%= d.destinationStop._id %>" <%= queryParams && queryParams.to == d.destinationStop._id ? 'selected' : '' %>>
                  <%= d.destinationStop.city %>
                </option>
              <% }) %>
            <% } %>
          </select>
          <i class="fa-solid fa-chevron-down dropdown-icon"></i>
        </div>

        <div class="search-input-group">
          <label for="departDate">Depart Date</label>
          <input type="date" id="departDate" name="departDate" value="<%= queryParams && queryParams.departDate ? queryParams.departDate : '' %>" />
        </div>

        <button type="submit" class="btn-search">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
      </form>
    </div>

    <!-- SEARCH RESULTS LIST -->
    <div class="results-container">
      <div class="results-header">
        <div>Coach</div>
        <div>Service</div>
        <div>Bus Type</div>
        <div>Departure <i class="fa-solid fa-arrow-up"></i></div>
        <div>Duration</div>
        <div>Arrival</div>
        <div>Available Seat</div>
        <div>Fare</div>
      </div>

      <% if (typeof trips !== 'undefined' && trips.length > 0) { %>
        <% trips.forEach((trip) => { %>
          <div class="bus-card mb-3" id="trip-card-<%= trip._id %>">
            <div class="bus-row">
              <div>
                <div class="bus-img-placeholder">
                  <i class="fa-solid fa-bus-simple fa-2x"></i>
                </div>
              </div>
              <div>
                <div class="service-code"><%= (trip && trip.bus && trip.bus.busNumber) ? trip.bus.busNumber : 'N/A' %></div>
                <div class="icon-bar">
                  <% if (trip.bus.amenities && trip.bus.amenities.length > 0) { %>
                    <% if (trip.bus.amenities.includes('wifi')) { %><i class="bi bi-wifi me-2" title="WiFi"></i><% } %>
                    <% if (trip.bus.amenities.includes('charging_point')) { %><i class="bi bi-plug me-2" title="Charging Point"></i><% } %>
                    <% if (trip.bus.amenities.includes('water_bottle')) { %><i class="bi bi-droplet me-2" title="Water Bottle"></i><% } %>
                    <% if (trip.bus.amenities.includes('blanket')) { %><i class="bi bi-box-seam me-2" title="Blanket"></i><% } %>
                  <% } else { %>
                    <span class="text-muted small">None</span>
                  <% } %>
                </div>
              </div>
              <div>
                <div class="bus-title">
                  <i class="fa-solid fa-bus" style="color: #007bff"></i>
                  <div class="service-code"><%= (trip && trip.bus && trip.bus.busType) ? trip.bus.busType : 'N/A' %></div>
                </div>
                <div class="sub-text"><%= trip.bus ? trip.bus.category : 'AC Seater/Sleeper' %></div>
              </div>
              <div>
                <div class="time-large">
                  <i class="fa-regular fa-clock"></i>
                  <%= new Date(trip.departureAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: false }) %>
                </div>
                <div class="sub-text"><%= new Date(trip.departureAt).toLocaleDateString('en-IN', { weekday: 'short', day: '2-digit', month: 'short' }) %></div>
              </div>
              <div class="duration-arrow">
                <i class="fa-solid fa-arrow-right"></i>
                <div>
                  <% 
                    const dep = new Date(trip.departureAt);
                    const arr = new Date(trip.arrivalAt);
                    const diffMs = arr - dep;
                    const totalMinutes = Math.floor(diffMs / (1000 * 60));
                    const hours = Math.floor(totalMinutes / 60);
                    const mins = totalMinutes % 60;
                  %>
                  <%= hours %>h <%= mins.toString().padStart(2, '0') %>m
                </div>
              </div>
              <div>
                <div class="time-large">
                  <i class="fa-regular fa-clock"></i>
                  <%= new Date(trip.arrivalAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: false }) %>
                </div>
                <div class="sub-text"><%= new Date(trip.arrivalAt).toLocaleDateString('en-IN', { weekday: 'short', day: '2-digit', month: 'short' }) %></div>
              </div>
              <div class="seats-count">
                <div class="sub-text">Available Seats:</div>
                <div style="font-weight: bold; color: var(--orange-main);"><%= trip.availableSeats %> Seats</div>
              </div>
              <div>
                <div class="fare-price">₹ <%= trip.baseFare %>/-</div>
                <% if (trip.availableSeats > 0) { %>
                  <button
                    class="btn-view-seats"
                    data-trip-id="<%= trip._id %>"
                    data-base-fare="<%= trip.baseFare %>"
                    data-premium-fare="<%= trip.premiumFare %>"              
                    data-total-seats="<%= trip.bus ? trip.bus.totalSeats : 20 %>"
                    data-bus-layout='<%- JSON.stringify((trip.bus && trip.bus.seatlayoutid) ? trip.bus.seatlayoutid : null) %>'
                    data-booked-seats='<%- JSON.stringify(trip.bookedSeatNumbers || []) %>'
                    onclick="handleViewSeatsClick(this)">
                    VIEW SEATS
                  </button>
                <% } else { %>
                  <div class="sold-out-text">Sold Out!</div>
                <% } %>
              </div>
            </div>

            <!-- IN-LINE SEAT ACCORDION PANEL -->
            <div class="seat-accordion-panel" id="seatAccordion-<%= trip._id %>">
              <button class="accordion-close-btn" type="button" onclick="toggleSeatPanel('<%= trip._id %>')">
                <i class="fa-solid fa-xmark"></i>
              </button>

              <div class="seat-layout-grid">
                <!-- SEAT MAP & LEGEND -->
                <div>
                  <div class="seat-legend">
                    <div class="legend-item"><div class="box available"></div> Regular</div>
                    <div class="legend-item"><div class="box premium"></div> Premium</div>
                    <div class="legend-item"><div class="box selected"></div> Selected</div>
                    <div class="legend-item"><div class="box booked"></div> Booked</div>
                  </div>

                  <div class="bus-deck-wrapper">
                    <div class="steering-wheel-bar">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <circle cx="12" cy="12" r="2.5" />
                        <path d="M12 3v6.5M4.2 17.5l5-4M19.8 17.5l-5-4" />
                      </svg>
                    </div>
                    <div class="bus-deck" id="seatDeck-<%= trip._id %>"></div>
                  </div>
                </div>

                <!-- FARE DETAILS & PASSENGER FORM -->
                <div class="booking-details-panel">
                  <div id="step1-fare-view-<%= trip._id %>">
                    <div class="fare-breakdown">
                      <h4>Fare Details</h4>
                      <div class="fare-row"><span>Seats Selected:</span> <strong id="lblSeats-<%= trip._id %>">-</strong></div>
                      <div class="fare-row"><span>Ticket Fare:</span> <span>₹ <span id="lblBaseFare-<%= trip._id %>">0</span></span></div>
                      <div class="fare-row"><span>GST (5%):</span> <span>₹ <span id="lblGst-<%= trip._id %>">0</span></span></div>
                      <div class="fare-row total"><span>Total Payable:</span> <span>₹ <span id="lblTotal-<%= trip._id %>">0</span></span></div>
                    </div>

                    <div class="route-dropdowns">
                      <div class="dropdown-group">
                        <label for="boardingPoint-<%= trip._id %>">Boarding Point</label>
                        <select id="boardingPoint-<%= trip._id %>" name="boardingPoint">
                          <option value="<%= trip.originStop ? trip.originStop.name : 'Origin Terminal' %>">
                            <%= trip.originStop ? trip.originStop.name : 'Origin Terminal' %>
                          </option>
                        </select>
                      </div>
                      <div class="dropdown-group">
                        <label for="dropoffPoint-<%= trip._id %>">Dropoff Point</label>
                        <select id="dropoffPoint-<%= trip._id %>" name="dropoffPoint">
                          <option value="<%= trip.destinationStop ? trip.destinationStop.name : 'Destination Terminal' %>">
                            <%= trip.destinationStop ? trip.destinationStop.name : 'Destination Terminal' %>
                          </option>
                        </select>
                      </div>
                    </div>

                    <button class="btn-action" id="btnContinue-<%= trip._id %>" type="button" disabled onclick="goToPassengerStep('<%= trip._id %>')">Continue</button>
                  </div>

                  <!-- STEP 2: STANDARD FORM SUBMISSION TO BACKEND -->
                  <div id="step2-passenger-view-<%= trip._id %>" style="display: none;">
                    <form action="/web/customer/booking/initiate" method="POST">
                      <input type="hidden" name="tripId" value="<%= trip._id %>" />
                      <input type="hidden" name="seats" id="inputSeats-<%= trip._id %>" />
                      <input type="hidden" name="totalAmount" id="inputTotalAmount-<%= trip._id %>" />
                      <input type="hidden" name="boardingPoint" id="inputBoarding-<%= trip._id %>" />
                      <input type="hidden" name="dropoffPoint" id="inputDropoff-<%= trip._id %>" />

                      <div class="section-heading">Passenger Details</div>
                      <div id="passengerFormsContainer-<%= trip._id %>" style="margin-bottom: 15px;"></div>

                      <div class="section-heading">Contact Information</div>
                      <div class="contact-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px;">
                        <div>
                          <input type="email" name="contactEmail" class="form-input" placeholder="Email Address" value="<%= (typeof user !== 'undefined' && user) ? user.email : '' %>" required />
                        </div>
                        <div>
                          <input type="text" name="contactPhone" class="form-input" placeholder="Mobile Number" value="<%= (typeof user !== 'undefined' && user) ? user.phone : '' %>" required />
                        </div>
                      </div>

                      <div style="display: flex; gap: 10px;">
                        <button class="btn-action btn-secondary" type="button" onclick="backToSeatStep('<%= trip._id %>')">Back</button>
                        <button class="btn-action" type="submit">
                          Proceed to Pay (<span id="btnPayAmount-<%= trip._id %>">₹0</span>)
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-5 bg-white rounded">
          <i class="fa-solid fa-bus-simple fa-3x text-muted mb-3"></i>
          <h5>No trips found matching your criteria.</h5>
          <p class="text-muted small">Try searching for a different date or route.</p>
        </div>
      <% } %>
    </div>

    <!-- FOOTER -->
    <%- include('../layouts/frontend_footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      const GST_RATE = 0.05;
      const tripStateMap = {};

      function toggleSeatPanel(tripId, baseFare = 0,premiumFare = 0, busLayout = null, defaultSeats = 20,bookedSeats = []) {
        const accordion = document.getElementById(`seatAccordion-${tripId}`);
        const isActive = accordion.classList.contains('active');

        document.querySelectorAll('.seat-accordion-panel').forEach(panel => panel.classList.remove('active'));

        if (!isActive) {
          accordion.classList.add('active');
          if (!tripStateMap[tripId]) {
            tripStateMap[tripId] = {
              selectedSeats: [],
              baseFare: baseFare,
              premiumFare: premiumFare,
              busLayout: busLayout,
              defaultSeats: defaultSeats,
              bookedSeats: bookedSeats
            };
            renderSeats(tripId);
          }

          if (window.innerWidth <= 991) {
            setTimeout(() => accordion.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
          }
        }
      }

      function handleViewSeatsClick(btn) {
        const tripId = btn.getAttribute("data-trip-id");

        const baseFare = parseFloat(btn.getAttribute("data-base-fare")) || 0;

        const premiumFare = parseFloat(btn.getAttribute("data-premium-fare")) || 0;

        const totalSeats = parseInt(btn.getAttribute("data-total-seats"), 10) || 20;

        let busLayout = null;
        let bookedSeats = [];

        try {
          busLayout = JSON.parse(
            btn.getAttribute("data-bus-layout")
          );
        } catch (err) {
          busLayout = null;
        }

        try {
          bookedSeats = JSON.parse(
            btn.getAttribute("data-booked-seats")
          );
        } catch (err) {
          bookedSeats = [];
        }

        toggleSeatPanel(
         tripId,
          baseFare,
          premiumFare,
          busLayout,
          totalSeats,
          bookedSeats
        );
      }

      function renderSeats(tripId) {
        const deck = document.getElementById(`seatDeck-${tripId}`);
        deck.innerHTML = "";
        const state = tripStateMap[tripId];

        if (state.busLayout && Array.isArray(state.busLayout.seats) && state.busLayout.seats.length > 0) {
          deck.style.display = "grid";
          deck.style.gridTemplateRows = `repeat(${state.busLayout.totalRows || 10}, minmax(40px, auto))`;
          deck.style.gridTemplateColumns = `repeat(${state.busLayout.totalColumns || 5}, minmax(40px, auto))`;
          deck.style.gap = "8px";

          state.busLayout.seats.forEach((seatData) => {

          const seatEl = document.createElement("div");

          seatEl.classList.add("seat");

          if (seatData.row && seatData.column) {
                  seatEl.style.gridRow = seatData.row;
            seatEl.style.gridColumn = seatData.column;
           }

          // -----------------------------------------
          // Aisle / Gap
          // -----------------------------------------

          if (seatData.isAisle || seatData.type === "gap") {

            seatEl.classList.add("aisle-gap");
            seatEl.style.pointerEvents = "none";

          } else {

            const seatNumber =
              seatData.seatNumber || seatData.label;

            seatEl.innerText = seatNumber;

            // -----------------------------------------
            // CHECK BOOKED STATUS FIRST
            // -----------------------------------------

            const isBooked =
              state.bookedSeats.includes(seatNumber);

            if (isBooked) {

              // Booked always wins over premium
              seatEl.classList.remove(
                "premium",
                "available",
                "selected"
              );

              seatEl.classList.add("booked");

              seatEl.style.pointerEvents = "none";

            } else {

              // -----------------------------------------
              // PREMIUM / REGULAR
              // -----------------------------------------

              if (
                seatData.isPremium ||
                seatData.seatType === "sleeper"
              ) {
              seatEl.classList.add("premium");
              } else {
              seatEl.classList.add("available");
              }

              // -----------------------------------------
              // SELECT SEAT
              // -----------------------------------------

              seatEl.onclick = () =>
                selectSeat(
                  tripId,
                  seatNumber,
                  seatEl
                );
            }
          }

          deck.appendChild(seatEl);
        });
              
          
        } else {
          deck.style.display = "grid";
          deck.style.gridTemplateColumns = "repeat(4, minmax(40px, 1fr))";
          deck.style.gap = "8px";

          for (let i = 1; i <= state.defaultSeats; i++) {
            const seatEl = document.createElement("div");
            seatEl.classList.add("seat", "available");
            seatEl.innerText = i;
            seatEl.onclick = () => selectSeat(tripId, String(i), seatEl);
            deck.appendChild(seatEl);
          }
        }
      }

      function selectSeat(tripId, seatId, element) {
        const state = tripStateMap[tripId];
        if (state.selectedSeats.includes(seatId)) {
          state.selectedSeats = state.selectedSeats.filter(id => id !== seatId);
          element.classList.remove("selected");
        } else {
          state.selectedSeats.push(seatId);
          element.classList.add("selected");
        }
        updateBilling(tripId);
      }

      function updateBilling(tripId) {
  const state = tripStateMap[tripId];

  let ticketFare = 0;

  state.selectedSeats.forEach((seatId) => {
    const seatData = state.busLayout?.seats?.find(
      (seat) => (seat.seatNumber || seat.label) === seatId
    );

    if (seatData && seatData.isPremium) {
      ticketFare += state.premiumFare;
    } else {
      ticketFare += state.baseFare;
    }
  });

  const gst = ticketFare * GST_RATE;
  const total = ticketFare + gst;

  document.getElementById(
    `lblSeats-${tripId}`
  ).innerText =
    state.selectedSeats.length > 0
      ? state.selectedSeats.join(", ")
      : "-";

  document.getElementById(
    `lblBaseFare-${tripId}`
  ).innerText =
    ticketFare.toFixed(2);

  document.getElementById(
    `lblGst-${tripId}`
  ).innerText =
    gst.toFixed(2);

  document.getElementById(
    `lblTotal-${tripId}`
  ).innerText =
    total.toFixed(2);

  document.getElementById(
    `btnPayAmount-${tripId}`
  ).innerText =
    `₹${total.toFixed(2)}`;

  document.getElementById(
    `btnContinue-${tripId}`
  ).disabled =
    state.selectedSeats.length === 0;

  // Hidden form values
  document.getElementById(
    `inputSeats-${tripId}`
  ).value =
    state.selectedSeats.join(",");

  document.getElementById(
    `inputTotalAmount-${tripId}`
  ).value =
    total.toFixed(2);

  document.getElementById(
    `inputBoarding-${tripId}`
  ).value =
    document.getElementById(
      `boardingPoint-${tripId}`
    ).value;

  document.getElementById(
    `inputDropoff-${tripId}`
  ).value =
    document.getElementById(
      `dropoffPoint-${tripId}`
    ).value;
}

      function goToPassengerStep(tripId) {
        document.getElementById(`step1-fare-view-${tripId}`).style.display = "none";
        document.getElementById(`step2-passenger-view-${tripId}`).style.display = "block";

        const container = document.getElementById(`passengerFormsContainer-${tripId}`);
        container.innerHTML = "";
        const state = tripStateMap[tripId];

        state.selectedSeats.forEach((seatId, idx) => {
          container.innerHTML += `
            <div class="passenger-row" data-seat="${seatId}">
              <span class="p-seat-label">Seat ${seatId}</span>
              <input type="hidden" name="passengers[${idx}][seatNo]" value="${seatId}" />
              <select name="passengers[${idx}][title]" class="form-input p-title">
                <option value="Mr">Mr</option>
                <option value="Ms">Ms</option>
                <option value="Mrs">Mrs</option>
              </select>
              <input type="text" name="passengers[${idx}][name]" class="form-input p-name" placeholder="Full Name" required />
              <input type="number" name="passengers[${idx}][age]" class="form-input p-age" placeholder="Age" required />
            </div>
          `;
        });

        if (window.innerWidth <= 991) {
          setTimeout(() => container.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
        }
      }

      function backToSeatStep(tripId) {
        document.getElementById(`step2-passenger-view-${tripId}`).style.display = "none";
        document.getElementById(`step1-fare-view-${tripId}`).style.display = "block";
      }

      // will not allow customer to select yesterday or any date before today
      document.addEventListener("DOMContentLoaded", () => {
        const travelDate = document.getElementById("departDate");
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, "0");
        const day = String(today.getDate()).padStart(2, "0");
        const todayDate = `${year}-${month}-${day}`;
        travelDate.min = todayDate;
      });
    </script>
  </body>
</html>