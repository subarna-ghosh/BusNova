<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Coupon Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../../layouts/admin_sidebar') %>

    <div class="admin-main">
      <%- include('../../layouts/admin_navbar') %>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Coupon Management</h1>
              <p>Discount codes and promotional offers.</p>
            </div>
            <button
              class="btn btn-brand"
              data-bs-toggle="modal"
              data-bs-target="#addCouponModal"
            >
              <i class="bi bi-plus-lg me-1"></i>Add Coupon
            </button>
          </div>

          <% if (success) { %>
              <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                  <i class="bi bi-check-circle-fill me-2"></i>
                  <%= success %>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
              <% } %>

              <% if (errors && errors.coupon) { %>
              <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                  <%= errors.coupon%>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
        <% } %>

          <div class="panel mt-4">
            <div class="table-responsive">
              <table class="table admin-table align-middle">
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Discount</th>
                    <th>Min Spend</th>
                    <th>Valid Period</th>
                    <th>Usage (Used/Limit)</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof coupons !== 'undefined' && coupons && coupons.length > 0) { %>
                    <% coupons.forEach((coupon) => { %>
                      <tr>
                        <td class="mono fw-semibold"><%= coupon.code %></td>
                        <td>
                          <% if (coupon.discountType === 'percentage') { %>
                            <%= coupon.discountValue %>% off
                            <% if (coupon.maxDiscount) { %>
                              <small class="text-muted d-block">(Up to ₹<%= coupon.maxDiscount %>)</small>
                            <% } %>
                          <% } else { %>
                            ₹<%= coupon.discountValue %> off
                          <% } %>
                        </td>
                        <td class="mono">₹<%= coupon.minAmount %></td>
                        <td class="small">
                          <%= new Date(coupon.validFrom).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                          <span class="text-muted">to</span>
                          <%= new Date(coupon.validTill).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td><%= coupon.usedCount %> / <%= coupon.usageLimit %></td>
                        <td>
                          <% if (coupon.status === 'active') { %>
                            <span class="badge badge-success">Active</span>
                          <% } else if (coupon.status === 'expired') { %>
                            <span class="badge badge-muted">Expired</span>
                          <% } else { %>
                            <span class="badge badge-danger">Disabled</span>
                          <% } %>
                        </td>
                        <td>
                          <button
                            class="icon-btn-sm edit-coupon-btn"
                            title="Edit Coupon"
                            data-bs-toggle="modal"
                            data-bs-target="#editCouponModal"
                            data-id="<%= coupon._id %>"
                            data-code="<%= coupon.code %>"
                            data-discounttype="<%= coupon.discountType %>"
                            data-discountvalue="<%= coupon.discountValue %>"
                            data-minamount="<%= coupon.minAmount %>"
                            data-maxdiscount="<%= coupon.maxDiscount || '' %>"
                            data-validfrom="<%= coupon.validFrom ? new Date(coupon.validFrom).toISOString().split('T')[0] : '' %>"
                            data-validtill="<%= coupon.validTill ? new Date(coupon.validTill).toISOString().split('T')[0] : '' %>"
                            data-usagelimit="<%= coupon.usageLimit %>"
                            data-status="<%= coupon.status %>"
                          >
                            <i class="bi bi-pencil"></i>
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="text-center text-muted py-4">No coupons available.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <!-- Add Coupon Modal -->
    <div class="modal fade" id="addCouponModal" tabindex="-1" aria-labelledby="addCouponModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="addCouponModalLabel">
              <i class="bi bi-tag-fill me-2 text-brand"></i>Add Coupon
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/web/admin/coupon/save" method="POST">
            <div class="modal-body">
              <div class="row g-3">
                <!-- Code -->
                <div class="col-md-6">
                  <label for="code" class="form-label small">Coupon Code</label>
                  <input type="text" class="form-control text-uppercase" id="code" name="code" placeholder="e.g. BUSNOVA20" required />
                </div>

                <!-- Discount Type -->
                <div class="col-md-6">
                  <label for="discountType" class="form-label small">Discount Type</label>
                  <select class="form-select" id="discountType" name="discountType" required>
                    <option value="percentage">Percentage (%)</option>
                    <option value="flat">Flat Amount (₹)</option>
                  </select>
                </div>

                <!-- Discount Value -->
                <div class="col-md-6">
                  <label for="discountValue" class="form-label small">Discount Value</label>
                  <input type="number" class="form-control" id="discountValue" name="discountValue" min="0" step="0.01" placeholder="e.g. 20 or 100" required />
                </div>

                <!-- Max Discount Amount -->
                <div class="col-md-6">
                  <label for="maxDiscount" class="form-label small">Max Discount Amount (₹) <span class="text-muted">(Optional)</span></label>
                  <input type="number" class="form-control" id="maxDiscount" name="maxDiscount" min="0" placeholder="e.g. 500" />
                </div>

                <!-- Min Booking Amount -->
                <div class="col-md-6">
                  <label for="minAmount" class="form-label small">Min Order Amount (₹)</label>
                  <input type="number" class="form-control" id="minAmount" name="minAmount" min="0" value="0" />
                </div>

                <!-- Usage Limit -->
                <div class="col-md-6">
                  <label for="usageLimit" class="form-label small">Total Usage Limit</label>
                  <input type="number" class="form-control" id="usageLimit" name="usageLimit" min="1" value="1" required />
                </div>

                <!-- Valid From -->
                <div class="col-md-6">
                  <label for="validFrom" class="form-label small">Valid From</label>
                  <input type="date" class="form-control" id="validFrom" name="validFrom" required />
                </div>

                <!-- Valid Till -->
                <div class="col-md-6">
                  <label for="validTill" class="form-label small">Valid Till</label>
                  <input type="date" class="form-control" id="validTill" name="validTill" required />
                </div>

                <!-- Initial Status -->
                <div class="col-md-12">
                  <label for="status" class="form-label small">Status</label>
                  <select class="form-select" id="status" name="status">
                    <option value="active" selected>Active</option>
                    <option value="disabled">Disabled</option>
                    <option value="expired">Expired</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-brand">Add Coupon</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Coupon Modal -->
    <div class="modal fade" id="editCouponModal" tabindex="-1" aria-labelledby="editCouponModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editCouponModalLabel">
              <i class="bi bi-pencil-square me-2 text-brand"></i>Edit Coupon
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form id="editCouponForm" action="" method="POST">
            <div class="modal-body">
              <div class="row g-3">
                <!-- Code -->
                <div class="col-md-6">
                  <label for="editCode" class="form-label small">Coupon Code</label>
                  <input type="text" class="form-control text-uppercase" id="editCode" name="code" required />
                </div>

                <!-- Discount Type -->
                <div class="col-md-6">
                  <label for="editDiscountType" class="form-label small">Discount Type</label>
                  <select class="form-select" id="editDiscountType" name="discountType" required>
                    <option value="percentage">Percentage (%)</option>
                    <option value="flat">Flat Amount (₹)</option>
                  </select>
                </div>

                <!-- Discount Value -->
                <div class="col-md-6">
                  <label for="editDiscountValue" class="form-label small">Discount Value</label>
                  <input type="number" class="form-control" id="editDiscountValue" name="discountValue" min="0" step="0.01" required />
                </div>

                <!-- Max Discount Amount -->
                <div class="col-md-6">
                  <label for="editMaxDiscount" class="form-label small">Max Discount Amount (₹)</label>
                  <input type="number" class="form-control" id="editMaxDiscount" name="maxDiscount" min="0" />
                </div>

                <!-- Min Booking Amount -->
                <div class="col-md-6">
                  <label for="editMinAmount" class="form-label small">Min Order Amount (₹)</label>
                  <input type="number" class="form-control" id="editMinAmount" name="minAmount" min="0" />
                </div>

                <!-- Usage Limit -->
                <div class="col-md-6">
                  <label for="editUsageLimit" class="form-label small">Total Usage Limit</label>
                  <input type="number" class="form-control" id="editUsageLimit" name="usageLimit" min="1" required />
                </div>

                <!-- Valid From -->
                <div class="col-md-6">
                  <label for="editValidFrom" class="form-label small">Valid From</label>
                  <input type="date" class="form-control" id="editValidFrom" name="validFrom" required />
                </div>

                <!-- Valid Till -->
                <div class="col-md-6">
                  <label for="editValidTill" class="form-label small">Valid Till</label>
                  <input type="date" class="form-control" id="editValidTill" name="validTill" required />
                </div>

                <!-- Status -->
                <div class="col-md-12">
                  <label for="editStatus" class="form-label small">Status</label>
                  <select class="form-select" id="editStatus" name="status">
                    <option value="active">Active</option>
                    <option value="disabled">Disabled</option>
                    <option value="expired">Expired</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-brand">Update Coupon</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/admin_dashboard.js"></script>

    <script>
      // Populate Edit Modal Form Fields dynamically
      document.querySelectorAll('.edit-coupon-btn').forEach(button => {
        button.addEventListener('click', function () {
          const couponId = this.getAttribute('data-id');
          const form = document.getElementById('editCouponForm');
          form.action = `/web/admin/coupon/update/${couponId}`;

          document.getElementById('editCode').value = this.getAttribute('data-code');
          document.getElementById('editDiscountType').value = this.getAttribute('data-discounttype');
          document.getElementById('editDiscountValue').value = this.getAttribute('data-discountvalue');
          document.getElementById('editMinAmount').value = this.getAttribute('data-minamount');
          document.getElementById('editMaxDiscount').value = this.getAttribute('data-maxdiscount');
          document.getElementById('editValidFrom').value = this.getAttribute('data-validfrom');
          document.getElementById('editValidTill').value = this.getAttribute('data-validtill');
          document.getElementById('editUsageLimit').value = this.getAttribute('data-usagelimit');
          document.getElementById('editStatus').value = this.getAttribute('data-status');
        });
      });
    </script>
  </body>
</html>