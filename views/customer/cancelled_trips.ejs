<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />
  <title>BusNova — Cancelled Trips</title>
  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />
  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />
  <!-- Dashboard CSS -->
  <link rel="stylesheet" href="/assets/css/admin_dashboard.css"/>
  <link rel="stylesheet" href="/assets/css/customer_dashboard.css"/>
</head>
<body>
  <!-- Sidebar backdrop -->
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
  <!-- Sidebar -->

  <%- include('../layouts/customer_sidebar') %>
  <div class="admin-main">
    <!-- Navbar -->
    <%- include('../layouts/customer_navbar') %>

    <main class="admin-content">
      <section class="admin-page">
        <!-- =========================================
             PAGE HEADER
        ========================================== -->
        <div class="page-head">
          <div>
            <h1>
              Cancelled Trips
            </h1>
            <p>
              Trips you've cancelled and their refund status.
            </p>
          </div>
        </div>

        <!-- =========================================
             CANCELLED TRIPS
        ========================================== -->

        <div class="panel">
          <div class="table-responsive">
            <table class="table admin-table align-middle">
              <thead>
                <tr>
                  <th>Booking</th>
                  <th>Route</th>
                  <th>Travel Date</th>
                  <th>Cancelled On</th>
                  <th>Amount</th>
                  <th>Refund Status</th>
                  <th class="text-center">Details</th>
                </tr>
              </thead>

              <tbody>

                <% if (
                  cancelledTrips &&
                  cancelledTrips.length > 0
                ) { %>


                  <% cancelledTrips.forEach((list) => { %>


                    <tr>
                      <!-- =================================
                           BOOKING
                      ================================== -->

                      <td class="mono">
                        <%= list.bookingCode || "—" %>
                      </td>

                      <!-- =================================
                           ROUTE
                      ================================== -->

                      <td>
                        <% if (
                          list.originStop &&
                          list.destinationStop
                        ) { %>

                          <%= list.originStop.city ||
                              list.originStop.name ||
                              "Origin" %>

                          <i
                            class="bi bi-arrow-right mx-1"
                          ></i>

                          <%= list.destinationStop.city ||
                              list.destinationStop.name ||
                              "Destination" %>

                        <% } else { %>

                          <span class="text-muted">
                            Route unavailable
                          </span>
                        <% } %>
                      </td>

                      <!-- =================================
                           TRAVEL DATE
                      ================================== -->

                      <td>

                        <% if (
                          list.trip &&
                          list.trip.departureAt
                        ) { %>

                          <%= new Date(
                            list.trip.departureAt
                          ).toLocaleDateString(
                            "en-IN",
                            {
                              day: "2-digit",
                              month: "short",
                              year: "numeric"
                            }
                          ) %>

                        <% } else { %>

                          —

                        <% } %>

                      </td>

                      <!-- =================================
                           CANCELLED ON
                      ================================== -->

                      <td>

                        <% if (list.updatedAt) { %>

                          <%= new Date(
                            list.updatedAt
                          ).toLocaleDateString(
                            "en-IN",
                            {
                              day: "2-digit",
                              month: "short",
                              year: "numeric"
                            }
                          ) %>
                        <% } else { %>

                          —

                        <% } %>
                      </td>

                      <!-- =================================
                           AMOUNT
                      ================================== -->

                      <td>
                        <strong>
                          ₹<%= Number(
                          list.totalAmount || 0
                          ).toFixed(2) %>
                         </strong>
                      </td>

                      <!-- =================================
                           REFUND STATUS
                      ================================== -->

                      <td>
                        <% if (
                          list.payment &&
                          list.payment.status === "refunded"
                        ) { %>
                          <span
                            class="badge badge-success"
                          >
                            <i
                              class="bi bi-check-circle me-1"
                            ></i>
                            Refunded
                          </span>

                        <% } else if (
                          list.payment &&
                          list.payment.status === "captured"
                        ) { %>

                          <span
                            class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"
                          >
                            <i
                              class="bi bi-clock me-1"
                            ></i>
                            Processing
                          </span>

                        <% } else if (
                          list.payment &&
                          list.payment.status === "failed"
                        ) { %>
                          <span
                            class="badge bg-danger-subtle text-danger border border-danger-subtle"
                          >
                            <i
                              class="bi bi-x-circle me-1"
                            ></i>

                            Failed
                          </span>

                        <% } else { %>
                          <span
                            class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"
                          >
                            <i
                              class="bi bi-dash-circle me-1"
                            ></i>
                            Not Available
                          </span>
                        <% } %>
                      </td>


                      <!-- =================================
                           DETAILS
                      ================================== -->

                      <td class="text-center">
                        <% if (
                          list.payment &&
                          list.payment.status === "refunded"
                        ) { %>
                          <a
                            href="/web/customer/payment/refunded/<%= list._id %>"
                            class="icon-btn-sm"
                            title="View refund"
                            aria-label="View refund"
                          >
                            <i
                              class="bi bi-receipt"
                            ></i>
                          </a>


                        <% } else { %>

                          <span
                            class="text-muted"
                            title="No refund details available"
                          >
                            <i
                              class="bi bi-dash-lg"
                            ></i>
                          </span>
                        <% } %>
                      </td>
                    </tr>

                  <% }) %>

                <% } else { %>


                  <!-- =====================================
                       EMPTY STATE
                  ====================================== -->

                  <tr>
                    <td
                      colspan="7"
                      class="text-center py-5"
                    >
                      <div class="mb-3">
                        <i
                          class="bi bi-calendar-x text-muted"
                          style="font-size: 42px;"
                        ></i>
                      </div>
                      <h5 class="mb-1">
                        No cancelled trips
                      </h5>
                      <p class="text-muted mb-0">
                        Your cancelled trips will appear here.
                      </p>
                    </td>
                  </tr>
                <% } %>

              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>
  </div>
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Customer Dashboard JS -->
  <script src="/assets/js/customer_dashboard.js"></script>
</body>
</html>