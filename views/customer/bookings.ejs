<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />

    <title>BusNova — Booking History</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Dashboard CSS -->
    <link
      rel="stylesheet"
      href="/assets/css/admin_dashboard.css"
    />

    <link
      rel="stylesheet"
      href="/assets/css/customer_dashboard.css"
    />
  </head>

  <body>

    <!-- Sidebar backdrop -->
    <div
      class="sidebar-backdrop"
      id="sidebarBackdrop"
    ></div>


    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <%- include('../layouts/customer_sidebar') %>


    <div class="admin-main">

      <!-- =========================================
           NAVBAR
      ========================================== -->

      <%- include('../layouts/customer_navbar') %>


      <!-- =========================================
           MAIN CONTENT
      ========================================== -->

      <main class="admin-content">

        <section class="admin-page">


          <!-- =========================================
               PAGE HEADER
          ========================================== -->

          <div class="page-head">

            <div>

              <h1>
                Booking History
              </h1>

              <p>
                All your past and current bookings in one place.
              </p>

            </div>

          </div>


          <!-- =========================================
               STATUS FILTER
          ========================================== -->

          <ul
            class="nav bn-pills mb-3"
            id="bookingFilterPills"
          >

            <li class="nav-item">

              <a
                href="#"
                class="nav-link active"
                data-filter="all"
              >
                All
              </a>

            </li>


            <li class="nav-item">

              <a
                href="#"
                class="nav-link"
                data-filter="confirmed"
              >
                Confirmed
              </a>

            </li>


            <li class="nav-item">

              <a
                href="#"
                class="nav-link"
                data-filter="completed"
              >
                Completed
              </a>

            </li>


            <li class="nav-item">

              <a
                href="#"
                class="nav-link"
                data-filter="cancelled"
              >
                Cancelled
              </a>

            </li>

          </ul>


          <!-- =========================================
               BOOKING TABLE
          ========================================== -->

          <div class="panel">

            <div class="table-responsive">

              <table
                class="table admin-table align-middle"
              >

                <!-- TABLE HEADER -->

                <thead>
                  <tr>
                    <th>Booking</th>
                    <th>Route</th>
                    <th>Date</th>
                    <th>Seats</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>

                </thead>
                <!-- TABLE BODY -->
                <tbody id="bookingHistoryBody">

                  <% if (
                    findBooking &&
                    findBooking.length > 0
                  ) { %>

                    <% findBooking.forEach((list) => { %>
                      <!-- =====================================
                           BOOKING ROW
                      ====================================== -->
                      <tr
                        class="booking-row"
                        data-status="<%= list.bookingStatus || 'unknown' %>"
                      >
                        <!-- =================================
                             BOOKING CODE
                        ================================== -->
                        <td>
                          <span class="mono">
                            <%= list.bookingCode || "N/A" %>
                          </span>
                        </td>
                        <!-- =================================
                             ROUTE
                        ================================== -->
                        <td>
                          <% if (
                            list.originStop &&
                            list.destinationStop
                          ) { %>
                            <span>
                              <%= list.originStop.city || list.originStop.name || "N/A" %>
                              <i
                                class="bi bi-arrow-right mx-1"
                              ></i>
                              <%= list.destinationStop.city || list.destinationStop.name || "N/A" %>
                            </span>
                          <% } else { %>
                            <span class="text-muted">
                              Route unavailable
                            </span>
                          <% } %>
                        </td>
                        <!-- =================================
                             DATE
                        ================================== -->
                        <td>
                          <% if (
                            list.trip &&
                            list.trip.departureAt
                          ) { %>

                            <%= new Date(
                              list.trip.departureAt
                            ).toLocaleDateString(
                              "en-IN",
                              {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                              }
                            ) %>

                          <% } else { %>

                            <span class="text-muted">
                              N/A
                            </span>
                          <% } %>
                        </td>
                        <!-- =================================
                             SEATS
                        ================================== -->
                        <td> 
                          <% if (Array.isArray(list.seatNumbers)) { %> 
                            <%= list.seatNumbers.join(", ") %> <% } 
                          else { %> 
                            <%= list.seatNumbers || "N/A" %> <% 
                          } %>
                        </td>
                        <!-- =================================
                             AMOUNT
                        ================================== -->
                        <td>
                          <strong>
                            ₹<%= Number(
                              list.totalAmount || 0
                            ).toFixed(2) %>
                          </strong>
                        </td>
                        <!-- =================================
                             STATUS
                        ================================== -->
                        <td>
                          <% if (
                            list.bookingStatus === "confirmed"
                          ) { %>
                            <span
                              class="badge badge-success"
                            >
                              <i
                                class="bi bi-check-circle me-1"
                              ></i>
                              Confirmed
                            </span>
                          <% } else if (
                            list.bookingStatus === "completed"
                          ) { %>
                            <span
                              class="badge bg-primary"
                            >
                              <i
                                class="bi bi-check2-all me-1"
                              ></i>
                              Completed
                            </span>
                          <% } else if (
                            list.bookingStatus === "cancelled"
                          ) { %>
                            <span
                              class="badge bg-danger"
                            >
                              <i
                                class="bi bi-x-circle me-1"
                              ></i>
                              Cancelled
                            </span>
                          <% } else if (
                            list.bookingStatus === "pending"
                          ) { %>
                            <span
                              class="badge bg-warning text-dark"
                            >
                              <i
                                class="bi bi-clock me-1"
                              ></i>
                              Pending
                            </span>
                          <% } else { %>
                            <span
                              class="badge bg-secondary"
                            >
                              <%= list.bookingStatus || "Unknown" %>
                            </span>
                          <% } %>
                        </td>
                        <!-- =================================
                             ACTION
                        ================================== -->
                        <td>
                          <% if (
                            list.bookingStatus === "confirmed"
                          ) { %>
                            <!--
                              Current payment summary controller
                              accepts confirmed bookings.
                            -->
                            <a
                              class="icon-btn-sm"
                              href="/web/customer/view/payment/summary/<%= list._id %>"
                              aria-label="View ticket"
                              title="View ticket"
                            >
                              <i
                                class="bi bi-eye"
                              ></i>
                            </a>
                          <% } else { %>
                            <!--
                              Completed / cancelled bookings
                              should not use the current payment
                              summary controller because that
                              controller requires:

                              bookingStatus: "confirmed"
                              payment status: "captured"
                            -->
                            <span
                              class="text-muted"
                              title="Ticket summary unavailable"
                            >
                              <i
                                class="bi bi-dash-circle"
                              ></i>
                            </span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <!-- =====================================
                         NO BOOKINGS
                    ====================================== -->

                    <tr id="noBookingsRow">
                      <td
                        colspan="7"
                        class="text-center py-5"
                      >
                        <div class="mb-2">
                          <i
                            class="bi bi-ticket-perforated fs-1 text-muted"
                          ></i>
                        </div>
                        <h5 class="mb-1">
                          No bookings found
                        </h5>

                        <p class="text-muted mb-0">
                          You haven't made any bookings yet.
                        </p>
                      </td>
                    </tr>
                  <% } %>

                  <!--
                    This row is hidden initially.
                    JavaScript shows it when a filter
                    has no matching bookings.
                  -->

                  <tr
                    id="noFilterResults"
                    style="display: none;"
                  >
                    <td
                      colspan="7"
                      class="text-center py-5"
                    >
                      <div class="mb-2">
                        <i
                          class="bi bi-search fs-1 text-muted"
                        ></i>
                      </div>
                      <h5 class="mb-1">
                        No bookings found
                      </h5>
                      <p class="text-muted mb-0">
                        No bookings match this filter.
                      </p>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
    <script
      src="/assets/js/customer_dashboard.js"
    ></script>
    <script>
      document.addEventListener(
        "DOMContentLoaded",
        () => {

          const filterLinks =
            document.querySelectorAll(
              "#bookingFilterPills .nav-link"
            );

          const bookingRows =
            document.querySelectorAll(
              ".booking-row"
            );

          const noFilterResults =
            document.getElementById(
              "noFilterResults"
            );


          filterLinks.forEach((link) => {

            link.addEventListener(
              "click",
              (event) => {

                event.preventDefault();


                /*
                 * -----------------------------
                 * ACTIVE TAB
                 * -----------------------------
                 */

                filterLinks.forEach(
                  (item) => {
                    item.classList.remove(
                      "active"
                    );
                  }
                );

                link.classList.add(
                  "active"
                );


                /*
                 * -----------------------------
                 * GET SELECTED FILTER
                 * -----------------------------
                 */

                const selectedFilter =
                  link.dataset.filter;


                let visibleCount = 0;


                /*
                 * -----------------------------
                 * FILTER BOOKINGS
                 * -----------------------------
                 */

                bookingRows.forEach(
                  (row) => {

                    const status =
                      row.dataset.status;


                    if (
                      selectedFilter === "all" ||
                      status === selectedFilter
                    ) {

                      row.style.display = "";

                      visibleCount++;

                    } else {

                      row.style.display = "none";

                    }

                  }
                );


                /*
                 * -----------------------------
                 * SHOW EMPTY FILTER MESSAGE
                 * -----------------------------
                 */

                if (
                  visibleCount === 0 &&
                  bookingRows.length > 0
                ) {

                  noFilterResults.style.display =
                    "";

                } else {

                  noFilterResults.style.display =
                    "none";

                }

              }
            );

          });

        }
      );

    </script>
  </body>
</html>