<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BusNova — My Profile</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
    <link rel="stylesheet" href="/assets/css/customer_dashboard.css" />
  </head>
  <body>
    <!-- SIDEBAR -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <%- include('../layouts/customer_sidebar') %>
    <!-- MAIN -->
    <div class="admin-main">
      <!-- NAVBAR -->
      <%- include('../layouts/customer_navbar') %>

      <main class="admin-content">
        <section class="admin-page">
          <!-- PAGE HEADER -->
          <div class="page-head">
            <div>
              <h1>My Profile</h1>
              <p>Manage your personal details and profile picture.</p>
            </div>
          </div>

          <!-- ========================================= -->
          <!-- STAT CARDS -->
          <!-- ========================================= -->

         <!-- STAT CARDS -->
          <div class="row g-3 stat-row">

            <!-- TOTAL TRIPS -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">

                <div class="stat-icon bg-orange">
                  <i class="bi bi-ticket-perforated"></i>
                </div>

                <div>
                  <div class="stat-value"><%=totalTrips%></div>
                  <div class="stat-label">Total trips</div>
                </div>

              </div>
            </div>


            <!-- UPCOMING TRIPS -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">

                <div class="stat-icon bg-ink">
                  <i class="bi bi-calendar2-check"></i>
                </div>

                <div>
                  <div class="stat-value"><%=upcomingTripCount%></div>
                  <div class="stat-label">Upcoming trips</div>
                </div>

              </div>
            </div>


            <!-- FAVORITE ROUTES -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">

                <div class="stat-icon bg-green">
                  <i class="bi bi-heart"></i>
                </div>

                <div>
                  <div class="stat-value"><%=favoriteRouteCount%></div>
                  <div class="stat-label">Favorite routes</div>
                </div>

              </div>
            </div>


            <!-- SEATS BOOKED -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">

                <div class="stat-icon bg-blue">
                  <i class="bi bi-grid-3x3-gap"></i>
                </div>

                <div>
                  <div class="stat-value">
                    <%= seatsBooked %>
                  </div>

                  <div class="stat-label">
                    Seats booked
                  </div>
                </div>

              </div>
            </div>

          </div>
          <!-- ========================================= -->
          <!-- FLASH SUCCESS MESSAGE -->
          <!-- ========================================= -->
          <% if (success) { %>

            <div
              class="alert alert-success alert-dismissible fade show mt-3"
              role="alert"
            >
              <i class="bi bi-check-circle-fill me-2"></i>
              <%= success %>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
              ></button>
            </div>
          <% } %>

          <!-- ========================================= -->
          <!-- FLASH ERROR MESSAGE -->
          <!-- ========================================= -->

          <% if (errors && errors.profile) { %>
            <div
              class="alert alert-danger alert-dismissible fade show mt-3"
              role="alert"
            >
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <%= errors.profile %>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
              ></button>
            </div>
          <% } %>

          <!-- ========================================= -->
          <!-- PROFILE CONTENT -->
          <!-- ========================================= -->

          <div class="row g-3 mt-1">
            <!-- ========================================= -->
            <!-- LEFT: PROFILE SUMMARY -->
            <!-- ========================================= -->
            <div class="col-lg-4">
              <div class="panel profile-summary-card text-center">
                <!-- PROFILE IMAGE -->
                <div class="position-relative d-inline-block mb-3">
                  <img
                    src="<%= findUser.profileImage || 'https://dduzhshimla.hp.gov.in/wp-content/uploads/2023/08/dummy-female-img.jpg' %>"
                    alt="Profile Picture"
                    id="avatarPreview"
                    class="rounded-circle img-thumbnail"
                    style="
                      width: 120px;
                      height: 120px;
                      object-fit: cover;
                    "
                  />
                </div>
                <!-- NAME -->
                <h2 class="profile-name">
                  <%= findUser.name %>
                </h2>
                <!-- MEMBER SINCE -->
                <p class="profile-since">
                  Member since

                  <%= new Date(findUser.createdAt).toLocaleDateString(
                    "en-US",
                    {
                      month: "short",
                      year: "numeric"
                    }
                  ) %>
                </p>
                <!-- STATUS -->
                <div class="profile-verify">
                  <span class="badge badge-success">
                    <i class="bi bi-check-circle me-1"></i>
                    Email verified
                  </span>
                  <span class="badge badge-success">
                    <i class="bi bi-check-circle me-1"></i>
                    Active Account
                  </span>
                </div>
              </div>
            </div>

            <!-- ========================================= -->
            <!-- RIGHT: UPDATE FORM -->
            <!-- ========================================= -->

            <div class="col-lg-8">
              <div class="panel">
                <div class="panel-head">
                  <h2>Update Profile</h2>
                </div>

                <!-- ===================================== -->
                <!-- FORM -->
                <!-- ===================================== -->

                <form
                  action="/web/customer/profile/update"
                  method="POST"
                  enctype="multipart/form-data"
                >
                  <div class="row g-3">
                    <!-- PROFILE IMAGE -->
                    <div class="col-12">
                      <label
                        for="profileImage"
                        class="form-label fw-semibold"
                      >
                        Profile Picture
                      </label>

                      <input
                        type="file"
                        class="form-control"
                        id="profileImage"
                        name="profileImage"
                        accept="image/png,image/jpeg,image/webp"
                      />

                      <div class="form-text">
                        JPG, PNG or WEBP
                      </div>

                    </div>
                    <!-- NAME -->
                    <div class="col-md-6">
                      <label
                        for="name"
                        class="form-label fw-semibold"
                      >
                        Full Name
                      </label>
                      <input
                        type="text"
                        class="form-control"
                        id="name"
                        name="name"
                        value="<%= old && old.name ? old.name : findUser.name %>"
                        placeholder="Enter your name"
                        required
                      />
                    </div>
                    <!-- EMAIL -->
                    <div class="col-md-6">

                      <label
                        for="email"
                        class="form-label fw-semibold"
                      >
                        Email Address
                      </label>

                      <input
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        value="<%= old && old.email ? old.email : findUser.email %>"
                        placeholder="Enter your email"
                        required
                      />
                    </div>
                    <!-- PHONE -->
                    <div class="col-md-6">
                      <label
                        for="phone"
                        class="form-label fw-semibold"
                      >
                        Mobile Number
                      </label>

                      <input
                        type="text"
                        class="form-control"
                        id="phone"
                        name="phone"
                        value="<%= old && old.phone ? old.phone : (findUser.phone || '') %>"
                        placeholder="Enter your mobile number"
                        required
                      />
                    </div>
                    <!-- STATUS -->

                    <div class="col-md-6">
                      <label
                        for="status"
                        class="form-label fw-semibold"
                      >
                        Account Status
                      </label>

                      <input
                        type="text"
                        class="form-control"
                        id="status"
                        value="<%= findUser.status %>"
                        readonly
                      />
                    </div>
                    <!-- SAVE BUTTON -->

                    <div class="col-12 mt-4">
                      <button
                        type="submit"
                        class="btn btn-brand"
                      >
                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes
                      </button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/assets/js/customer_dashboard.js"></script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const notificationMenu =
          document.getElementById("notificationMenu");

        const notificationDot =
          document.getElementById("notificationDot");

        const socket = io();

        socket.on("connect", () => {
          console.log("Customer socket connected:", socket.id);

          socket.emit("joinUserRoom", "<%= currentUserId %>");

          socket.emit("joinRoleRoom", "Customer");
        });

        socket.on("newNotification", (notification) => {
          console.log("New notification:", notification);

          addNotification(notification);

          if (notificationDot) {
            notificationDot.style.display = "block";
          }
        });

        function addNotification(notification) {

          // Remove "No new notifications"
          const noNotification =
            document.getElementById("noNotificationItem");

          if (noNotification) {
            noNotification.remove();
          }

          const item = document.createElement("li");

          item.className = "notif-item";

          item.innerHTML = `
            <i class="bi bi-bell text-brand"></i>

            <div>
              <strong>${escapeHtml(notification.title)}</strong>

              <span>${escapeHtml(notification.message)}</span>
            </div>
          `;

         notificationMenu.prepend(item);
        }

        function escapeHtml(value) {
          const div = document.createElement("div");

          div.textContent = value;

          return div.innerHTML;
        }
      });
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {

        const imageInput =
          document.getElementById("profileImage");

        const avatarPreview =
          document.getElementById("avatarPreview");
        imageInput.addEventListener("change", (event) => {
          const file = event.target.files[0];
          if (!file) {
            return;
          }
          // Check file type
          if (!file.type.startsWith("image/")) {
            alert("Please select an image file.");
            imageInput.value = "";
            return;
          }
          // Preview image
          const reader = new FileReader();
          reader.onload = (event) => {
            avatarPreview.src =
              event.target.result;
          };
          reader.readAsDataURL(file);
        });
      });
    </script>
  </body>
</html>