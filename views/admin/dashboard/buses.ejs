<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Bus Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../../layouts/admin_sidebar') %>

    <div class="admin-main">
      <%- include('../../layouts/admin_navbar') %>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Bus Management</h1>
              <p>Every bus in your fleet, in one place.</p>
            </div>
            <button
              class="btn btn-brand"
              data-bs-toggle="modal"
              data-bs-target="#addBusModal"
            >
              <i class="bi bi-plus-lg me-1"></i>Add Bus
            </button>
          </div>

          <% if (success) { %>
              <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                  <i class="bi bi-check-circle-fill me-2"></i>
                  <%= success %>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
              <% } %>

              <% if (errors && errors.bus) { %>
              <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                  <%= errors.bus %>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
        <% } %>

          <div class="panel">
            <div class="table-responsive">
              <table class="table admin-table align-middle">
                <thead>
                  <tr>
                    <th>Bus No.</th>
                    <th>Reg No.</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Amenities</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="busesTableBody">
                  <% if (typeof buses !== 'undefined' && buses.length > 0) { %>
                    <% buses.forEach((bus) => { %>
                      <tr>
                        <td class="mono fw-bold"><%= bus.busNumber %></td>
                        <td class="mono"><%= bus.registrationNumber %></td>
                        <td class="text-capitalize"><%= bus.busType.replace('_', ' ') %></td>
                        <td><%= bus.totalSeats %></td>
                        <td>
                          <% if (bus.amenities && bus.amenities.length > 0) { %>
                            <% if (bus.amenities.includes('wifi')) { %><i class="bi bi-wifi me-2" title="WiFi"></i><% } %>
                            <% if (bus.amenities.includes('charging_point')) { %><i class="bi bi-plug me-2" title="Charging Point"></i><% } %>
                            <% if (bus.amenities.includes('water_bottle')) { %><i class="bi bi-droplet me-2" title="Water Bottle"></i><% } %>
                            <% if (bus.amenities.includes('blanket')) { %><i class="bi bi-box-seam me-2" title="Blanket"></i><% } %>
                          <% } else { %>
                            <span class="text-muted small">None</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (bus.status === 'active') { %>
                            <span class="badge badge-success">Active</span>
                          <% } else if (bus.status === 'maintenance') { %>
                            <span class="badge badge-warning">Maintenance</span>
                          <% } else { %>
                            <span class="badge badge-muted">Inactive</span>
                          <% } %>
                        </td>
                        <td>
                          <!-- Pass the bus data inside data-bus attribute -->
                          <button 
                            class="icon-btn-sm edit-bus-btn" 
                            title="Edit Bus"
                            data-bs-toggle="modal"
                            data-bs-target="#editBusModal"
                            data-bus='<%= JSON.stringify(bus) %>'
                          >
                            <i class="bi bi-pencil"></i>
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="text-center text-muted py-4">
                        No buses added yet. Click <strong>Add Bus</strong> to get started.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <!-- Add Bus Modal -->
    <div class="modal fade" id="addBusModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form method="POST" action="/web/admin/buses/save">
            <div class="modal-header">
              <h5 class="modal-title">Add Bus</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body">
              <!-- Bus Number -->
              <div class="mb-3">
                <label class="form-label small">Bus Number</label>
                <input 
                  type="text" 
                  name="busNumber" 
                  class="form-control" 
                  placeholder="e.g. BN-15 NV" 
                  required 
                />
              </div>

              <!-- Registration Number -->
              <div class="mb-3">
                <label class="form-label small">Registration Number</label>
                <input 
                  type="text" 
                  name="registrationNumber" 
                  class="form-control" 
                  placeholder="e.g. MH-12-AB-1234" 
                  required 
                />
              </div>

              <!-- Bus Type -->
              <div class="mb-3">
                <label class="form-label small">Type</label>
                <select name="busType" class="form-select" required>
                  <option value="seater">Seater</option>
                  <option value="semi_sleeper">Semi-Sleeper</option>
                  <option value="sleeper">Sleeper</option>
                  <option value="sleeper_ac">Sleeper A/C</option>
                </select>
              </div>

              <!-- Seat Capacity -->
              <div class="mb-3">
                <label class="form-label small">Seat Capacity</label>
                <input 
                  type="number" 
                  name="totalSeats" 
                  class="form-control" 
                  placeholder="40" 
                  min="1" 
                  required 
                />
              </div>

              <!-- Seat Layout Selection (Optional) -->
              <div class="mb-3">
                <label class="form-label small">Seat Layout (Optional)</label>
                <select name="seatLayoutId" class="form-select">
                  <option value="">-- Select Layout --</option>
                  <% if (typeof seatLayouts !== 'undefined' && seatLayouts.length > 0) { %>
                    <% seatLayouts.forEach((layout) => { %>
                      <option value="<%= layout._id %>"><%= layout.name %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <!-- Status -->
              <div class="mb-3">
                <label class="form-label small">Status</label>
                <select name="status" class="form-select">
                  <option value="active" selected>Active</option>
                  <option value="maintenance">Maintenance</option>
                  <option value="inactive">Inactive</option>
                </select>
              </div>

              <!-- Amenities -->
              <div class="mb-3">
                <label class="form-label small d-block">Amenities</label>
                <div class="d-flex flex-wrap gap-3">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="wifi" id="wifi">
                    <label class="form-check-label small" for="wifi">WiFi</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="charging_point" id="charging">
                    <label class="form-check-label small" for="charging">Charging Point</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="water_bottle" id="water">
                    <label class="form-check-label small" for="water">Water Bottle</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="blanket" id="blanket">
                    <label class="form-check-label small" for="blanket">Blanket</label>
                  </div>
                </div>
              </div>
            </div>

            <div class="modal-footer">
              <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">
                Cancel
              </button>
              <button type="submit" class="btn btn-brand">
                Add Bus
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Bus Modal -->
      <div class="modal fade" id="editBusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <form id="editBusForm" method="POST" action="">
              <div class="modal-header">
                <h5 class="modal-title">Edit Bus</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
        
              <div class="modal-body">
                <!-- Bus Number -->
                <div class="mb-3">
                  <label class="form-label small">Bus Number</label>
                 <input 
                   type="text" 
                    name="busNumber" 
                    id="editBusNumber"
                    class="form-control" 
                    required 
                  />
               </div>

                <!-- Registration Number -->
                <div class="mb-3">
                  <label class="form-label small">Registration Number</label>
                  <input 
                    type="text" 
                    name="registrationNumber" 
                    id="editRegistrationNumber"
                    class="form-control" 
                    required 
                  />
                </div>

                <!-- Bus Type -->
                <div class="mb-3">
                  <label class="form-label small">Type</label>
                  <select name="busType" id="editBusType" class="form-select" required>
                    <option value="seater">Seater</option>
                    <option value="semi_sleeper">Semi-Sleeper</option>
                    <option value="sleeper">Sleeper</option>
                    <option value="sleeper_ac">Sleeper A/C</option>
                  </select>
                </div>

                <!-- Seat Capacity -->
                <div class="mb-3">
                  <label class="form-label small">Seat Capacity</label>
                  <input 
                    type="number" 
                    name="totalSeats" 
                    id="editTotalSeats"
                    class="form-control" 
                    min="1" 
                    required 
                  />
                </div>

                <!-- Seat Layout Selection -->
               <div class="mb-3">
                 <label class="form-label small">Seat Layout (Optional)</label>
                  <select name="seatLayoutId" id="editSeatLayoutId" class="form-select">
                    <option value="">-- Select Layout --</option>
                    <% if (typeof seatLayouts !== 'undefined' && seatLayouts.length > 0) { %>
                      <% seatLayouts.forEach((layout) => { %>
                        <option value="<%= layout._id %>"><%= layout.name %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Status -->
                <div class="mb-3">
                 <label class="form-label small">Status</label>
                  <select name="status" id="editStatus" class="form-select">
                    <option value="active">Active</option>
                    <option value="maintenance">Maintenance</option>
                    <option value="inactive">Inactive</option>
                  </select>
                </div>

                <!-- Amenities -->
                <div class="mb-3">
                  <label class="form-label small d-block">Amenities</label>
                  <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                      <input class="form-check-input edit-amenity" type="checkbox" name="amenities" value="wifi" id="editWifi">
                      <label class="form-check-label small" for="editWifi">WiFi</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input edit-amenity" type="checkbox" name="amenities" value="charging_point" id="editCharging">
                      <label class="form-check-label small" for="editCharging">Charging Point</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input edit-amenity" type="checkbox" name="amenities" value="water_bottle" id="editWater">
                      <label class="form-check-label small" for="editWater">Water Bottle</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input edit-amenity" type="checkbox" name="amenities" value="blanket" id="editBlanket">
                      <label class="form-check-label small" for="editBlanket">Blanket</label>
                   </div>
                  </div>
                </div>
              </div>

              <div class="modal-footer">
                <button type="button" class="btn btn-outline-brand" data-bs-dismiss="modal">
                  Cancel
                </button>
                <button type="submit" class="btn btn-brand">
                  Update Bus
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/admin_dashboard.js"></script>
    <script>
  document.addEventListener("DOMContentLoaded", () => {
    const editBtns = document.querySelectorAll(".edit-bus-btn");
    const editForm = document.getElementById("editBusForm");

    editBtns.forEach((btn) => {
      btn.addEventListener("click", function () {
        const bus = JSON.parse(this.getAttribute("data-bus"));

        // Set Form Action Route with Bus ID
        editForm.action = `/web/admin/buses/edit/${bus._id}`;

        // Populate Simple Text & Select Inputs
        document.getElementById("editBusNumber").value = bus.busNumber || "";
        document.getElementById("editRegistrationNumber").value = bus.registrationNumber || "";
        document.getElementById("editBusType").value = bus.busType || "seater";
        document.getElementById("editTotalSeats").value = bus.totalSeats || 0;
        document.getElementById("editSeatLayoutId").value = bus.seatLayoutId || "";
        document.getElementById("editStatus").value = bus.status || "active";

        // Reset and Check Amenities Checkboxes
        document.querySelectorAll(".edit-amenity").forEach((cb) => {
          cb.checked = bus.amenities && bus.amenities.includes(cb.value);
        });
      });
    });
  });
</script>
  </body>
</html>