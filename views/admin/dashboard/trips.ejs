<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Trip Scheduling</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../../layouts/admin_sidebar') %>

    <div class="admin-main">
      <%- include('../../layouts/admin_navbar') %>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Trip Scheduling</h1>
              <p>Assign buses and drivers to upcoming departures.</p>
            </div>
            <button
              class="btn btn-brand"
              data-bs-toggle="modal"
              data-bs-target="#addTripModal"
            >
              <i class="bi bi-plus-lg me-1"></i>Schedule Trip
            </button>
          </div>

          <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <%= success %>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>
            </div>
          <% } %>

          <% if (errors && errors.trip) { %>
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <%= errors.trip %>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>
            </div>
          <% } %>

          <div class="panel mt-4">
            <div class="table-responsive">
              <table class="table admin-table align-middle">
                <thead>
                  <tr>
                    <th>Route</th>
                    <th>Bus</th>
                    <th>Driver</th>
                    <th>Departure</th>
                    <th>Arrival</th>
                    <th>Fare</th>
                    <th>Available Seats</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof trips !== 'undefined' && trips && trips.length > 0) { %>
                    <% trips.forEach((trip) => { %>
                      <tr>
                        <td class="fw-semibold">
                          <%= trip.routeId ? `${trip.originStop?.name || trip.routeId.origin} → ${trip.destinationStop?.name || trip.routeId.destination}` : 'Unassigned Route' %>
                        </td>
                        <td class="mono"><%= trip.bus?.busNumber || 'N/A' %></td>
                        <td><%= trip.userInfo?.name || 'N/A' %></td>
                        <td><%= trip.departureAt ? new Date(trip.departureAt).toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' }) : 'N/A' %></td>
                        <td><%= trip.arrivalAt ? new Date(trip.arrivalAt).toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' }) : 'N/A' %></td>
                        <td class="mono">₹<%= trip.baseFare %></td>
                        <td><%= trip.availableSeats %></td>
                        <td>
                          <% if (trip.status === 'scheduled') { %>
                            <span class="badge badge-muted">Scheduled</span>
                          <% } else if (trip.status === 'boarding') { %>
                            <span class="badge badge-warning">Boarding</span>
                          <% } else if (trip.status === 'departed') { %>
                            <span class="badge badge-info">Departed</span>
                          <% } else if (trip.status === 'completed') { %>
                            <span class="badge badge-success">Completed</span>
                          <% } else if (trip.status === 'delayed') { %>
                            <span class="badge badge-warning text-dark">Delayed</span>
                          <% } else if (trip.status === 'cancelled') { %>
                            <span class="badge badge-danger">Cancelled</span>
                          <% } %>
                        </td>
                        <td>
                          <button
                            class="icon-btn-sm edit-trip-btn"
                            title="Edit Trip"
                            data-bs-toggle="modal"
                            data-bs-target="#editTripModal"
                            data-id="<%= trip._id %>"
                            data-routeid="<%= trip.routeId?._id || '' %>"
                            data-busid="<%= trip.busId?._id || '' %>"
                            data-driverid="<%= trip.driverId?._id || '' %>"
                            data-departureat="<%= trip.departureAt ? new Date(trip.departureAt).toISOString().slice(0, 16) : '' %>"
                            data-arrivalat="<%= trip.arrivalAt ? new Date(trip.arrivalAt).toISOString().slice(0, 16) : '' %>"
                            data-basefare="<%= trip.baseFare %>"
                            data-premiumFare="<%= trip.premiumFare %>"
                            data-availableseats="<%= trip.availableSeats %>"
                            data-status="<%= trip.status %>"
                          >
                            <i class="bi bi-pencil"></i>
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="9" class="text-center text-muted py-4">No scheduled trips found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <!-- Schedule Trip Modal -->
    <div class="modal fade" id="addTripModal" tabindex="-1" aria-labelledby="addTripModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="addTripModalLabel">
              <i class="bi bi-calendar-plus me-2 text-brand"></i>Schedule Trip
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/web/admin/trip/save" method="POST">
            <div class="modal-body">
              <div class="row g-3">
                <!-- Route Select -->
                <div class="col-12">
                  <label for="routeId" class="form-label small">Route</label>
                  <select class="form-select" id="routeId" name="routeId" required>
                    <option value="" disabled selected>Select Route</option>
                    <% if (typeof routes !== 'undefined' && routes && routes.length > 0) { %>
                      <% routes.forEach((route) => { %>
                        <option value="<%= route._id %>">
                          <%= route.originStop?.name || route.origin %> → <%= route.destinationStop?.name || route.destination %>
                        </option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Bus Select -->
                <div class="col-md-6">
                  <label for="busId" class="form-label small">Bus</label>
                  <select class="form-select" id="busId" name="busId" required>
                    <option value="" disabled selected>Select Bus</option>
                    <% if (typeof buses !== 'undefined' && buses && buses.length > 0) { %>
                      <% buses.forEach((bus) => { %>
                        <option value="<%= bus._id %>">
                          <%= bus.busNumber %> (<%= bus.busType || 'Standard' %>)
                        </option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Driver Select -->
                <div class="col-md-6">
                  <label for="driverId" class="form-label small">Driver</label>
                  <select class="form-select" id="driverId" name="driverId" required>
                    <option value="" disabled selected>Select Driver</option>
                    <% if (typeof drivers !== 'undefined' && drivers && drivers.length > 0) { %>
                      <% drivers.forEach((driver) => { %>
                        <option value="<%= driver._id %>">
                          <%= driver.user?.name || driver.name || 'Unknown Driver' %>
                        </option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Departure Time -->
                <div class="col-md-6">
                  <label for="departureAt" class="form-label small">Departure Time</label>
                  <input type="datetime-local" class="form-control" id="departureAt" name="departureAt" required />
                </div>

                <!-- Arrival Time -->
                <div class="col-md-6">
                  <label for="arrivalAt" class="form-label small">Estimated Arrival Time</label>
                  <input type="datetime-local" class="form-control" id="arrivalAt" name="arrivalAt" required />
                </div>

                <!-- Base Fare -->
                <div class="col-md-6">
                  <label for="baseFare" class="form-label small">Normal Seat Fare (₹)</label>
                  <input type="number" class="form-control" id="baseFare" name="baseFare" min="0" step="0.01" placeholder="e.g. 450" required />
                </div>

                <!-- Premium Fare -->
                <div class="col-md-6">
                  <label for="premiumFare" class="form-label small">Premium Seat Fare (₹)</label>
                  <input type="number" class="form-control" id="premiumFare" name="premiumFare" min="0" step="0.01" placeholder="e.g. 600" required />
                </div>

                <!-- Initial Status -->
                <div class="col-12">
                  <label for="status" class="form-label small">Status</label>
                  <select class="form-select" id="status" name="status">
                    <option value="scheduled" selected>Scheduled</option>
                    <option value="boarding">Boarding</option>
                    <option value="departed">Departed</option>
                    <option value="completed">Completed</option>
                    <option value="delayed">Delayed</option>
                    <option value="cancelled">Cancelled</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-brand">Schedule Trip</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Trip Modal -->
    <div class="modal fade" id="editTripModal" tabindex="-1" aria-labelledby="editTripModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editTripModalLabel">
              <i class="bi bi-pencil-square me-2 text-brand"></i>Edit Scheduled Trip
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form id="editTripForm" action="" method="POST">
            <div class="modal-body">
              <div class="row g-3">
                <!-- Route Select -->
                <div class="col-12">
                  <label for="editRouteId" class="form-label small">Route</label>
                  <select class="form-select" id="editRouteId" name="routeId" required>
                    <% if (typeof routes !== 'undefined' && routes && routes.length > 0) { %>
                      <% routes.forEach((route) => { %>
                        <option value="<%= route._id %>">
                          <%= route.originStop?.name || route.origin %> → <%= route.destinationStop?.name || route.destination %>
                        </option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Bus Select -->
                <div class="col-md-6">
                  <label for="editBusId" class="form-label small">Bus</label>
                  <select class="form-select" id="editBusId" name="busId" required>
                    <% if (typeof buses !== 'undefined' && buses && buses.length > 0) { %>
                      <% buses.forEach((bus) => { %>
                        <option value="<%= bus._id %>"><%= bus.busNumber %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Driver Select -->
                <div class="col-md-6">
                  <label for="editDriverId" class="form-label small">Driver</label>
                  <select class="form-select" id="editDriverId" name="driverId" required>
                    <% if (typeof drivers !== 'undefined' && drivers && drivers.length > 0) { %>
                      <% drivers.forEach((driver) => { %>
                        <option value="<%= driver._id %>">
                          <%= driver.user?.name || driver.name || 'Unknown Driver' %>
                        </option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Departure Time -->
                <div class="col-md-6">
                  <label for="editDepartureAt" class="form-label small">Departure Time</label>
                  <input type="datetime-local" class="form-control" id="editDepartureAt" name="departureAt" required />
                </div>

                <!-- Arrival Time -->
                <div class="col-md-6">
                  <label for="editArrivalAt" class="form-label small">Estimated Arrival Time</label>
                  <input type="datetime-local" class="form-control" id="editArrivalAt" name="arrivalAt" required />
                </div>

                <!-- Base Fare -->
                <div class="col-md-6">
                  <label for="editBaseFare" class="form-label small">Base Fare (₹)</label>
                  <input type="number" class="form-control" id="editBaseFare" name="baseFare" min="0" step="0.01" required />
                </div>

                <!-- Premium Fare -->
                <div class="col-md-6">
                  <label for="editPremiumFare" class="form-label small">Premium Seat Fare (₹)</label>
                  <input type="number" class="form-control" id="editPremiumFare" name="premiumFare" min="0" step="0.01" required />
                </div>

                <!-- Available Seats -->
                <div class="col-12">
                  <label for="editAvailableSeats" class="form-label small">Available Seats</label>
                  <input type="number" class="form-control" id="editAvailableSeats" name="availableSeats" min="0" required />
                </div>

                <!-- Status Select -->
                <div class="col-12">
                  <label for="editStatus" class="form-label small">Status</label>
                  <select class="form-select" id="editStatus" name="status">
                    <option value="scheduled">Scheduled</option>
                    <option value="boarding">Boarding</option>
                    <option value="departed">Departed</option>
                    <option value="completed">Completed</option>
                    <option value="delayed">Delayed</option>
                    <option value="cancelled">Cancelled</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-brand">Update Trip</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/admin_dashboard.js"></script>

    <script>
      // Populate Edit Trip Modal Data dynamically on button click
      document.querySelectorAll('.edit-trip-btn').forEach(button => {
        button.addEventListener('click', function () {
          const tripId = this.getAttribute('data-id');
          const form = document.getElementById('editTripForm');
          form.action = `/web/admin/trip/update/${tripId}`;

          document.getElementById('editRouteId').value = this.getAttribute('data-routeid');
          document.getElementById('editBusId').value = this.getAttribute('data-busid');
          document.getElementById('editDriverId').value = this.getAttribute('data-driverid');
          document.getElementById('editDepartureAt').value = this.getAttribute('data-departureat');
          document.getElementById('editArrivalAt').value = this.getAttribute('data-arrivalat');
          document.getElementById('editBaseFare').value = this.getAttribute('data-basefare');
          document.getElementById("editPremiumFare").value = this.getAttribute('data-premiumFare');
          document.getElementById('editAvailableSeats').value = this.getAttribute('data-availableseats');
          document.getElementById('editStatus').value = this.getAttribute('data-status');
        });
      });
    </script>
  </body>
</html>