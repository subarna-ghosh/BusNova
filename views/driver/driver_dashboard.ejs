<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Assigned Trips</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
    <link rel="stylesheet" href="/assets/css/driver_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
   <!-- SIDEBAR -->
    <%- include('../layouts/driver_sidebar') %>

    <div class="admin-main">
      <!-- NAVBAR -->
      <%- include('../layouts/driver_navbar') %>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Assigned Trips</h1>
              <p>Your trips for today and the days ahead.</p>
            </div>
            <a href="/web/driver/view/trip/schedule" class="btn btn-outline-brand"><i class="bi bi-calendar2-week me-1"></i>View Full Schedule</a>
          </div>

          <div class="row g-3 stat-row">
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-orange"><i class="bi bi-bus-front"></i></div>
                <div>
                  <div class="stat-value">3</div>
                  <div class="stat-label">Trips today</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-ink"><i class="bi bi-people"></i></div>
                <div>
                  <div class="stat-value">86</div>
                  <div class="stat-label">Passengers today</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-green"><i class="bi bi-check2-circle"></i></div>
                <div>
                  <div class="stat-value">96%</div>
                  <div class="stat-label">On-time rate</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-blue"><i class="bi bi-clock-history"></i></div>
                <div>
                  <div class="stat-value">22:30</div>
                  <div class="stat-label">Next departure</div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-lg-7">
              <div class="panel">
                <div class="panel-head">
                  <h2>Today's trips</h2>
                </div>
                <div class="table-responsive">
                  <table class="table admin-table align-middle">
                    <thead>
                      <tr><th>Trip</th><th>Route</th><th>Bus</th><th>Departure</th><th>Passengers</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="mono">#TRP-2291</td><td>Kolkata → Digha</td><td>BN-04 NV</td><td>22:30</td><td>38/40</td>
                        <td><span class="badge badge-warning">Boarding</span></td>
                        <td><a class="icon-btn-sm" href="/web/driver/view/passenger/list" aria-label="View passenger list"><i class="bi bi-people"></i></a></td>
                      </tr>
                      <tr>
                        <td class="mono">#TRP-2287</td><td>Kolkata → Puri</td><td>BN-11 NV</td><td>23:00</td><td>40/40</td>
                        <td><span class="badge badge-success">Confirmed</span></td>
                        <td><a class="icon-btn-sm" href="passenger_list.html?trip=TRP-2287" aria-label="View passenger list"><i class="bi bi-people"></i></a></td>
                      </tr>
                      <tr>
                        <td class="mono">#TRP-2280</td><td>Bangalore → Hyderabad</td><td>BN-22 NV</td><td>06:15 (tmrw)</td><td>30/45</td>
                        <td><span class="badge badge-muted">Scheduled</span></td>
                        <td><a class="icon-btn-sm" href="passenger_list.html?trip=TRP-2280" aria-label="View passenger list"><i class="bi bi-people"></i></a></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="panel">
                <div class="panel-head">
                  <h2>Next departures</h2>
                </div>
                <ul class="trip-list">
                  <li>
                    <div class="trip-time">22:30</div>
                    <div>
                      <div class="trip-route">Kolkata → Digha</div>
                      <div class="trip-sub">BN-04 NV · Co-driver: A. Das</div>
                    </div>
                    <span class="badge badge-warning">Boarding</span>
                  </li>
                  <li>
                    <div class="trip-time">23:00</div>
                    <div>
                      <div class="trip-route">Kolkata → Puri</div>
                      <div class="trip-sub">BN-11 NV · Co-driver: K. Reddy</div>
                    </div>
                    <span class="badge badge-success">Confirmed</span>
                  </li>
                  <li>
                    <div class="trip-time">06:15</div>
                    <div>
                      <div class="trip-route">Bangalore → Hyderabad</div>
                      <div class="trip-sub">BN-22 NV · Co-driver: S. Rao</div>
                    </div>
                    <span class="badge badge-muted">Scheduled</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/driver_dashboard.js"></script>
  </body>
</html>
