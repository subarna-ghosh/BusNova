<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Bus Agency Management &amp; Ticket Booking</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/landing_page.css" />
    <link rel="stylesheet" href="css/responsive.css" />
  </head>
  <body>
    <!-- NAVBAR -->
    <%- include('../layouts/frontend_navbar') %>

    <!-- HERO -->
    <header id="home" class="hero d-flex align-items-center text-white">
      <div class="container text-center" data-aos="fade-up">
        <span class="eyebrow d-inline-block mb-3"
          >Bus agency management, simplified</span
        >
        <h1 class="display-4 fw-bold">Book direct. Board direct.</h1>
        <p class="lead mb-4">
          BusNova runs your fleet, routes and fares behind the scenes — and
          gives passengers a fast, reliable way to book their next trip.
        </p>
        <div
          class="search-card mx-auto"
          data-aos="fade-up"
          data-aos-delay="150"
        >
          <!-- search buses -->
          <form action="/buses/search" method="GET">
            <div class="row g-2 align-items-end">
              <!-- From (Origin) Select Dropdown -->
              <div class="col-md-3 text-start">
                <label for="origin" class="form-label small text-dark mb-1"
                  >From</label
                >
                <select class="form-select" id="origin" name="origin" required>
                  <option value="" disabled>Select origin city</option>
                  <option value="Kolkata" selected>Kolkata</option>
                  <option value="Digha">Digha</option>
                  <option value="Siliguri">Siliguri</option>
                  <option value="Asansol">Asansol</option>
                </select>
              </div>

              <!-- To (Destination) Select Dropdown -->
              <div class="col-md-3 text-start">
                <label for="destination" class="form-label small text-dark mb-1"
                  >To</label
                >
                <select
                  class="form-select"
                  id="destination"
                  name="destination"
                  required
                >
                  <option value="" disabled>Select destination city</option>
                  <option value="Kolkata">Kolkata</option>
                  <option value="Digha" selected>Digha</option>
                  <option value="Siliguri">Siliguri</option>
                  <option value="Asansol">Asansol</option>
                </select>
              </div>

              <!-- Departure Date -->
              <div class="col-md-3 text-start">
                <label for="travelDate" class="form-label small text-dark mb-1"
                  >Departure</label
                >
                <input
                  type="date"
                  class="form-control"
                  id="travelDate"
                  name="date"
                  required
                />
              </div>

              <!-- Submit Button -->
              <div class="col-md-3">
                <button type="submit" class="btn btn-brand w-100">
                  Search buses
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </header>

    <!-- TRUST STRIP -->
    <section class="trust-strip">
      <div class="container">
        <div class="row text-center g-3">
          <div class="col-6 col-md-3">
            <div class="trust-num">410+</div>
            <div class="trust-label">Agencies onboard</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="trust-num">90+</div>
            <div class="trust-label">Buses managed</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="trust-num">50+</div>
            <div class="trust-label">Active routes</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="trust-num">100K+</div>
            <div class="trust-label">Tickets booked</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ROUTES -->
    <section id="routes" class="container py-5">
      <div class="text-center mb-5" data-aos="fade-up">
        <span class="eyebrow-dark d-inline-block mb-2">Where agencies run</span>
        <h2 class="fw-bold">Popular Routes</h2>
        <p class="text-muted">
          Every route below is live on a BusNova booking page.
        </p>
      </div>
      <div class="row g-3">
        <div class="col-6 col-md-3" data-aos="zoom-in">
          <div class="card route-card p-3">
            <span class="route-name">Kolkata → Puri</span>
            <span class="route-price">₹650</span>
          </div>
        </div>
        <div class="col-6 col-md-3" data-aos="zoom-in" data-aos-delay="50">
          <div class="card route-card p-3">
            <span class="route-name">Delhi → Jaipur</span>
            <span class="route-price">₹500</span>
          </div>
        </div>
        <div class="col-6 col-md-3" data-aos="zoom-in" data-aos-delay="100">
          <div class="card route-card p-3">
            <span class="route-name">Bangalore → Hyderabad</span>
            <span class="route-price">₹850</span>
          </div>
        </div>
        <div class="col-6 col-md-3" data-aos="zoom-in" data-aos-delay="150">
          <div class="card route-card p-3">
            <span class="route-name">Kolkata → Digha</span>
            <span class="route-price">₹450</span>
          </div>
        </div>
        <div class="col-6 col-md-3" data-aos="zoom-in">
          <div class="card route-card p-3">
            <span class="route-name">Kolkata → Siliguri</span>
            <span class="route-price">₹750</span>
          </div>
        </div>
        <div class="col-6 col-md-3" data-aos="zoom-in" data-aos-delay="50">
          <div class="card route-card p-3">
            <span class="route-name">Puri → Durgapur</span>
            <span class="route-price">₹600</span>
          </div>
        </div>
        <div class="col-6 col-md-3" data-aos="zoom-in" data-aos-delay="100">
          <div class="card route-card p-3">
            <span class="route-name">Coimbatore → Hyderabad</span>
            <span class="route-price">₹900</span>
          </div>
        </div>
        <div class="col-6 col-md-3" data-aos="zoom-in" data-aos-delay="150">
          <div class="card route-card p-3">
            <span class="route-name">Bhubaneswar → Bankura</span>
            <span class="route-price">₹550</span>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="how-section py-5">
      <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
          <h2 class="fw-bold">From Search to Seat, in Four Stops</h2>
          <p class="text-dark">
            The same flow your passengers follow on their phone.
          </p>
        </div>
        <div class="row g-4 text-center">
          <div class="col-md-3" data-aos="fade-up">
            <div class="step-icon mx-auto"><i class="bi bi-search"></i></div>
            <h5 class="mt-3">Search the route</h5>
            <p class="text-dark small">
              Enter origin, destination and travel date.
            </p>
          </div>
          <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
            <div class="step-icon mx-auto"><i class="bi bi-ui-checks"></i></div>
            <h5 class="mt-3">Choose a trip</h5>
            <p class="text-dark small">Compare timing, bus type and fare.</p>
          </div>
          <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
            <div class="step-icon mx-auto">
              <i class="bi bi-credit-card-2-front"></i>
            </div>
            <h5 class="mt-3">Pay securely</h5>
            <p class="text-dark small">Fare confirmed instantly at checkout.</p>
          </div>
          <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
            <div class="step-icon mx-auto">
              <i class="bi bi-ticket-perforated"></i>
            </div>
            <h5 class="mt-3">Get the ticket</h5>
            <p class="text-dark small">
              A digital ticket lands in their inbox.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="testimonials py-5">
      <div class="container">
        <h2 class="text-center fw-bold mb-5" data-aos="fade-up">
          Customer Feedback
        </h2>
        <div
          id="feedbackCarousel"
          class="carousel slide mx-auto"
          style="max-width: 700px"
          data-bs-ride="carousel"
        >
          <div class="carousel-inner text-center">
            <div class="carousel-item active">
              <div class="avatar mx-auto mb-3">RB</div>
              <p class="t-quote">
                "BusNova is the smoothest bus booking I've used. I traveled from
                Bhubaneswar to Bangalore and had my ticket in under two
                minutes."
              </p>
              <div class="t-name">Rajesh Bahera</div>
              <div class="t-role">Bhubaneswar</div>
            </div>
            <div class="carousel-item">
              <div class="avatar mx-auto mb-3">AS</div>
              <p class="t-quote">
                "As an agency owner, switching to BusNova cut our no-show rate
                in half. Setup took an afternoon, not a month."
              </p>
              <div class="t-name">Anwesha Sen</div>
              <div class="t-role">Fleet owner, Kolkata</div>
            </div>
            <div class="carousel-item">
              <div class="avatar mx-auto mb-3">MK</div>
              <p class="t-quote">
                "Booking the Bangalore–Hyderabad route took under two minutes,
                and the e-ticket showed up before I'd even put my phone away."
              </p>
              <div class="t-name">Manoj Kumar</div>
              <div class="t-role">Hyderabad</div>
            </div>
          </div>
          <div
            class="carousel-controls mt-4 d-flex align-items-center justify-content-center gap-3"
          >
            <button
              class="carousel-arrow"
              type="button"
              data-bs-target="#feedbackCarousel"
              data-bs-slide="prev"
            >
              <i class="bi bi-chevron-left"></i>
            </button>
            <div class="carousel-indicators-custom">
              <button
                data-bs-target="#feedbackCarousel"
                data-bs-slide-to="0"
                class="active"
              ></button>
              <button
                data-bs-target="#feedbackCarousel"
                data-bs-slide-to="1"
              ></button>
              <button
                data-bs-target="#feedbackCarousel"
                data-bs-slide-to="2"
              ></button>
            </div>
            <button
              class="carousel-arrow"
              type="button"
              data-bs-target="#feedbackCarousel"
              data-bs-slide="next"
            >
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="stats-band py-5">
      <div class="container">
        <div class="row text-center g-3">
          <div class="col-6 col-md-3">
            <div class="stat-num">90+</div>
            <div class="stat-label">Buses on the platform</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="stat-num">50+</div>
            <div class="stat-label">Active routes</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="stat-num">100K+</div>
            <div class="stat-label">Tickets booked</div>
          </div>
          <div class="col-6 col-md-3">
            <div class="stat-num">99.9%</div>
            <div class="stat-label">Booking uptime</div>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section id="gallery" class="container py-5">
      <div class="text-center mb-5" data-aos="fade-up">
        <h2 class="fw-bold">Our Gallery</h2>
        <p class="text-muted">A look at what every BusNova trip includes.</p>
      </div>
      <div
        id="galleryCarousel"
        class="carousel slide"
        data-bs-ride="carousel"
        data-aos="fade-up"
      >
        <div class="carousel-inner">
          <div class="carousel-item active">
            <div class="row g-3 justify-content-center">
              <div class="col-6 col-md-4">
                <div class="card gallery-card p-4 text-center h-100">
                  <i class="bi bi-moon-stars fs-1"></i>
                  <h5 class="mt-3">Sleeper Cabins</h5>
                  <p class="text-muted small">
                    Curtained berths with reading lights on overnight routes.
                  </p>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <div class="card gallery-card p-4 text-center h-100">
                  <i class="bi bi-person-workspace fs-1"></i>
                  <h5 class="mt-3">Push-back Seating</h5>
                  <p class="text-muted small">
                    Comfortable reclining rows mapped seat by seat.
                  </p>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <div class="card gallery-card p-4 text-center h-100">
                  <i class="bi bi-plug fs-1"></i>
                  <h5 class="mt-3">Charging &amp; WiFi</h5>
                  <p class="text-muted small">
                    USB points and onboard WiFi on every booking page.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class="carousel-item">
            <div class="row g-3 justify-content-center">
              <div class="col-6 col-md-4">
                <div class="card gallery-card p-4 text-center h-100">
                  <i class="bi bi-briefcase fs-1"></i>
                  <h5 class="mt-3">Luggage Deck</h5>
                  <p class="text-muted small">
                    Under-bus capacity tracked per trip.
                  </p>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <div class="card gallery-card p-4 text-center h-100">
                  <i class="bi bi-geo-alt fs-1"></i>
                  <h5 class="mt-3">Live Tracking</h5>
                  <p class="text-muted small">
                    Drivers share GPS position in real time.
                  </p>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <div class="card gallery-card p-4 text-center h-100">
                  <i class="bi bi-cup-hot fs-1"></i>
                  <h5 class="mt-3">Onboard Comfort</h5>
                  <p class="text-muted small">
                    Blankets, pillows and refreshment stops.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="carousel-controls mt-4 d-flex align-items-center justify-content-center gap-3"
        >
          <button
            class="carousel-arrow"
            type="button"
            data-bs-target="#galleryCarousel"
            data-bs-slide="prev"
          >
            <i class="bi bi-chevron-left"></i>
          </button>
          <div class="carousel-indicators-custom">
            <button
              data-bs-target="#galleryCarousel"
              data-bs-slide-to="0"
              class="active"
            ></button>
            <button
              data-bs-target="#galleryCarousel"
              data-bs-slide-to="1"
            ></button>
          </div>
          <button
            class="carousel-arrow"
            type="button"
            data-bs-target="#galleryCarousel"
            data-bs-slide="next"
          >
            <i class="bi bi-chevron-right"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="why-section py-5">
      <div class="container">
        <h2 class="text-center fw-bold mb-5" data-aos="fade-up">
          Why Choose Us
        </h2>
        <div class="row g-4">
          <div class="col-md-4" data-aos="zoom-in">
            <div class="card feature-card p-4 text-center">
              <i class="bi bi-wifi fs-1"></i>
              <h5 class="mt-3">Free WiFi</h5>
            </div>
          </div>
          <div class="col-md-4" data-aos="zoom-in" data-aos-delay="50">
            <div class="card feature-card p-4 text-center">
              <i class="bi bi-geo-alt fs-1"></i>
              <h5 class="mt-3">Live Tracking</h5>
            </div>
          </div>
          <div class="col-md-4" data-aos="zoom-in" data-aos-delay="100">
            <div class="card feature-card p-4 text-center">
              <i class="bi bi-credit-card fs-1"></i>
              <h5 class="mt-3">Secure Payment</h5>
            </div>
          </div>
          <div class="col-md-4" data-aos="zoom-in">
            <div class="card feature-card p-4 text-center">
              <i class="bi bi-arrow-repeat fs-1"></i>
              <h5 class="mt-3">Quick Refunds</h5>
            </div>
          </div>
          <div class="col-md-4" data-aos="zoom-in" data-aos-delay="50">
            <div class="card feature-card p-4 text-center">
              <i class="bi bi-plug fs-1"></i>
              <h5 class="mt-3">Charging Point</h5>
            </div>
          </div>
          <div class="col-md-4" data-aos="zoom-in" data-aos-delay="100">
            <div class="card feature-card p-4 text-center">
              <i class="bi bi-cloud-moon fs-1"></i>
              <h5 class="mt-3">Blanket &amp; Pillow</h5>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="contact" class="container py-5">
      <div class="cta-panel text-center text-white p-5" data-aos="zoom-in">
        <span class="eyebrow d-inline-block mb-2">Ready when you are</span>
        <h2 class="fw-bold">Put Your Fleet on BusNova This Week</h2>
        <p class="mb-4">
          No setup fee. Bring your routes and bus layouts, and we'll help you
          get your booking page live.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
          <a href="#" class="btn btn-brand px-4">Start Free Trial</a>
          <a href="#" class="btn btn-light px-4">Book a Demo</a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <%- include('../layouts/frontend_footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
      AOS.init();
    </script>

    <!-- <script src="js/script.js"></script> -->
  </body>
</html>
