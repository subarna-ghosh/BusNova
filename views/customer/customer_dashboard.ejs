<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — My Profile</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
    <link rel="stylesheet" href="/assets/css/customer_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%-include('../layouts/customer_sidebar')%>

    <div class="admin-main">
      <%-include('../layouts/customer_navbar')%>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>My Profile</h1>
              <p>Manage your personal details and travel preferences.</p>
            </div>
            <button class="btn btn-brand" id="editProfileBtn">
              <i class="bi bi-pencil me-1"></i>Edit Profile
            </button>
          </div>

          <div class="row g-3 stat-row">
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-orange">
                  <i class="bi bi-ticket-perforated"></i>
                </div>
                <div>
                  <div class="stat-value">18</div>
                  <div class="stat-label">Total trips</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-ink">
                  <i class="bi bi-calendar2-check"></i>
                </div>
                <div>
                  <div class="stat-value">2</div>
                  <div class="stat-label">Upcoming trips</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-green">
                  <i class="bi bi-heart"></i>
                </div>
                <div>
                  <div class="stat-value">3</div>
                  <div class="stat-label">Favorite routes</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-blue">
                  <i class="bi bi-people"></i>
                </div>
                <div>
                  <div class="stat-value">4</div>
                  <div class="stat-label">Saved passengers</div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-lg-4">
              <div class="panel profile-summary-card">
                <div class="profile-avatar">AR</div>
                <h2 class="profile-name">Ankita Roy</h2>
                <p class="profile-since">Member since Mar 2024</p>
                <div class="profile-verify">
                  <span class="badge badge-success"
                    ><i class="bi bi-check-circle me-1"></i>Email verified</span
                  >
                  <span class="badge badge-success"
                    ><i class="bi bi-check-circle me-1"></i>Phone verified</span
                  >
                </div>
              </div>
            </div>
            <div class="col-lg-8">
              <div class="panel">
                <div class="panel-head">
                  <h2>Personal details</h2>
                </div>
                <form class="row g-3" id="profileForm">
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold"
                      >Full name</label
                    >
                    <input
                      type="text"
                      class="form-control"
                      value="Ankita Roy"
                      disabled
                    />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold"
                      >Email address</label
                    >
                    <input
                      type="email"
                      class="form-control"
                      value="ankita.roy@example.com"
                      disabled
                    />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold"
                      >Mobile number</label
                    >
                    <input
                      type="text"
                      class="form-control"
                      value="+91 98300 44521"
                      disabled
                    />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold"
                      >Date of birth</label
                    >
                    <input
                      type="date"
                      class="form-control"
                      value="1998-07-14"
                      disabled
                    />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold">Gender</label>
                    <select class="form-select" disabled>
                      <option>Female</option>
                      <option>Male</option>
                      <option>Prefer not to say</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small fw-semibold">City</label>
                    <input
                      type="text"
                      class="form-control"
                      value="Kolkata"
                      disabled
                    />
                  </div>
                  <div class="col-12">
                    <label class="form-label small fw-semibold">Address</label>
                    <textarea class="form-control" rows="2" disabled>
42, Southern Avenue, Kolkata, West Bengal 700029</textarea
                    >
                  </div>
                  <div class="col-12 d-none" id="profileSaveRow">
                    <button type="submit" class="btn btn-brand">
                      Save changes
                    </button>
                    <button
                      type="button"
                      class="btn btn-outline-brand"
                      id="cancelEditBtn"
                    >
                      Cancel
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/customer_dashboard.js"></script>
  </body>
</html>
