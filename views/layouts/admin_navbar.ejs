<header class="admin-topbar">
  <button class="icon-btn d-lg-none" id="sidebarToggle" aria-label="Open menu">
    <i class="bi bi-list"></i>
  </button>

  <div class="topbar-search">
    <i class="bi bi-search"></i>
    <input type="text" placeholder="Search bookings, buses, customers…" />
  </div>

  <div class="topbar-actions">
    <button
      class="icon-btn"
      aria-label="Notifications"
      data-bs-toggle="dropdown"
    >
      <i class="bi bi-bell"></i>
      <span class="icon-dot"></span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end notif-menu">
      <li class="notif-item">
        <i class="bi bi-ticket-perforated text-brand"></i>
        <div>
          <strong>New booking</strong><span>Seat 4B on Kolkata → Digha</span>
        </div>
      </li>
      <li class="notif-item">
        <i class="bi bi-exclamation-triangle text-danger"></i>
        <div>
          <strong>Trip delayed</strong><span>BN-04 NV running 20 min late</span>
        </div>
      </li>
      <li class="notif-item">
        <i class="bi bi-cash-coin text-success"></i>
        <div>
          <strong>Payment received</strong
          ><span>₹1,300 for booking #10493</span>
        </div>
      </li>
    </ul>

    <div class="dropdown">
      <button
        class="admin-profile"
        data-bs-toggle="dropdown"
        aria-label="Admin menu"
      >
        <span class="avatar-initials">
          <%= findAdmin
            .split(" ")
            .map(word => word.charAt(0))
            .join("")
            .toUpperCase()
          %>
        </span>
        <span class="d-none d-md-inline"><%= findAdmin%></span>
        <i class="bi bi-chevron-down small"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <a class="dropdown-item" href="#"
            ><i class="bi bi-person me-2"></i>My profile</a
          >
        </li>
        <li>
          <a class="dropdown-item" href="#"
            ><i class="bi bi-gear me-2"></i>Account settings</a
          >
        </li>
        <li><hr class="dropdown-divider" /></li>
        <li>
          <a class="dropdown-item" href="/web/auth/logout"
            ><i class="bi bi-box-arrow-right me-2"></i>Sign out</a
          >
        </li>
      </ul>
    </div>
  </div>
</header>
