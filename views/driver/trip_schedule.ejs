<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>BusNova — Trip Schedule</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  <link rel="stylesheet" href="/assets/css/driver_dashboard.css" />
</head>

<body>

  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <!-- DRIVER SIDEBAR -->
  <%- include('../layouts/driver_sidebar') %>

  <div class="admin-main">
    <!-- DRIVER NAVBAR -->
    <%- include('../layouts/driver_navbar') %>

    <main class="admin-content">
      <section class="admin-page">

        <div class="page-head">
          <div>
            <h1>Trip Schedule</h1>
            <p>Your upcoming duty roster.</p>
          </div>
        </div>

        <!-- FILTER TABS -->
        <ul class="nav bn-pills mb-3" id="scheduleFilterPills">
          <li class="nav-item">
            <a class="nav-link active" href="#" data-range="week">This week</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#" data-range="next">Next week</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#" data-range="all">All upcoming</a>
          </li>
        </ul>

        <!-- SCHEDULE CONTAINER -->
        <div id="scheduleContainer">
          <% if (groupedSchedules && Object.keys(groupedSchedules).length > 0) { %>
            <% Object.keys(groupedSchedules).forEach((dateKey) => { %>

              <div class="schedule-day-block" data-date="<%= dateKey %>">
                <div class="schedule-day-heading">
                  <h3>
                    <%= new Date(dateKey + 'T00:00:00').toLocaleDateString("en-IN", {
                      weekday: "short",
                      day: "2-digit",
                      month: "short",
                      year: "numeric"
                    }) %>
                  </h3>
                  <span class="schedule-day-count">
                    <%= groupedSchedules[dateKey].length %> <%= groupedSchedules[dateKey].length === 1 ? "trip" : "trips" %>
                  </span>
                </div>

                <div class="panel">
                  <ul class="trip-list">
                    <% groupedSchedules[dateKey].forEach((trip) => { %>
                      <li>
                        <div class="trip-time">
                          <%= new Date(trip.departureAt).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: false }) %>
                        </div>

                        <div>
                          <div class="trip-route">
                            <%= trip.originStop?.city || "Unknown City" %><%= trip.originStop?.state ? `, ${trip.originStop.state}` : '' %>
                            →
                            <%= trip.destinationStop?.city || "Unknown City" %><%= trip.destinationStop?.state ? `, ${trip.destinationStop.state}` : '' %>
                          </div>

                          <div class="duty-sub">
                            <%= trip.originStop?.name || "Unknown Stop" %> → <%= trip.destinationStop?.name || "Unknown Stop" %>
                          </div>

                          <div class="duty-sub">
                            <i class="bi bi-bus-front me-1"></i>
                            <%= trip.bus?.busNumber || "Bus not assigned" %> · Duty: Driving
                          </div>

                          <div class="duty-sub">
                            <i class="bi bi-clock me-1"></i>
                            Arrival: <%= new Date(trip.arrivalAt).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: false }) %>
                          </div>
                        </div>

                        <!-- STATUS BADGES -->
                        <div>
                          <% if (trip.status === "scheduled") { %>
                            <span class="badge badge-muted">Scheduled</span>
                          <% } else if (trip.status === "boarding") { %>
                            <span class="badge badge-warning">Boarding</span>
                          <% } else if (trip.status === "delayed") { %>
                            <span class="badge badge-warning">Delayed</span>
                          <% } else if (trip.status === "departed") { %>
                            <span class="badge badge-success">Departed</span>
                          <% } else if (trip.status === "completed") { %>
                            <span class="badge badge-success">Completed</span>
                          <% } %>
                        </div>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              </div>

            <% }) %>
          <% } else { %>
            <div class="panel text-center p-5">
              <i class="bi bi-calendar-x" style="font-size: 42px;"></i>
              <h4 class="mt-3">No upcoming trips</h4>
              <p class="text-muted mb-0">You currently have no scheduled trips.</p>
            </div>
          <% } %>
        </div>

        <!-- DYNAMIC EMPTY STATE (FILTER RESULTS ARE EMPTY) -->
        <div id="filterEmptyState" class="panel text-center p-5" style="display: none;">
          <i class="bi bi-calendar-event text-muted" style="font-size: 42px;"></i>
          <h4 class="mt-3">No trips scheduled</h4>
          <p class="text-muted mb-0" id="filterEmptyMessage">
            You have no trips scheduled for this timeframe.
          </p>
        </div>

      </section>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/driver_dashboard.js"></script>

  <!-- TAB FILTER LOGIC -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const filterPills = document.querySelectorAll("#scheduleFilterPills .nav-link");
      const dayBlocks = document.querySelectorAll(".schedule-day-block");
      const emptyState = document.getElementById("filterEmptyState");
      const emptyMessage = document.getElementById("filterEmptyMessage");

      function applyFilter(range) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        // Start of current week (Monday)
        const startOfWeek = new Date(today);
        const dayIndex = today.getDay() === 0 ? 6 : today.getDay() - 1; 
        startOfWeek.setDate(today.getDate() - dayIndex);

        // End of current week (Sunday night)
        const endOfWeek = new Date(startOfWeek);
        endOfWeek.setDate(startOfWeek.getDate() + 6);
        endOfWeek.setHours(23, 59, 59, 999);

        // Next week start and end
        const startOfNextWeek = new Date(startOfWeek);
        startOfNextWeek.setDate(startOfWeek.getDate() + 7);

        const endOfNextWeek = new Date(startOfNextWeek);
        endOfNextWeek.setDate(startOfNextWeek.getDate() + 6);
        endOfNextWeek.setHours(23, 59, 59, 999);

        let visibleCount = 0;

        dayBlocks.forEach((block) => {
          const dateStr = block.getAttribute("data-date");
          const blockDate = new Date(dateStr + "T00:00:00");

          let isVisible = false;

          if (range === "week") {
            isVisible = (blockDate >= startOfWeek && blockDate <= endOfWeek);
          } else if (range === "next") {
            isVisible = (blockDate >= startOfNextWeek && blockDate <= endOfNextWeek);
          } else if (range === "all") {
            isVisible = true;
          }

          if (isVisible) {
            block.style.display = "block";
            visibleCount++;
          } else {
            block.style.display = "none";
          }
        });

        // Show empty message if no day blocks match
        if (dayBlocks.length > 0 && visibleCount === 0) {
          if (range === "week") {
            emptyMessage.textContent = "You have no trips scheduled for this week.";
          } else if (range === "next") {
            emptyMessage.textContent = "You have no trips scheduled for next week.";
          } else {
            emptyMessage.textContent = "You have no upcoming trips scheduled.";
          }
          emptyState.style.display = "block";
        } else {
          emptyState.style.display = "none";
        }
      }

      filterPills.forEach((pill) => {
        pill.addEventListener("click", (e) => {
          e.preventDefault();

          filterPills.forEach((p) => p.classList.remove("active"));
          pill.classList.add("active");

          const range = pill.getAttribute("data-range");
          applyFilter(range);
        });
      });

      // Default load: apply "This week" filter
      applyFilter("week");
    });
  </script>

</body>

</html>