<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Driver Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../../layouts/admin_sidebar') %>

    <div class="admin-main">
      <%- include('../../layouts/admin_navbar') %>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Driver Management</h1>
              <p>License details and current assignments.</p>
            </div>
            <button
              class="btn btn-brand"
              data-bs-toggle="modal"
              data-bs-target="#addDriverModal"
            >
              <i class="bi bi-plus-lg me-1"></i>Add Driver
            </button>
          </div>


          <% if (success) { %>
              <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                  <i class="bi bi-check-circle-fill me-2"></i>
                  <%= success %>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
              <% } %>

              <% if (errors && errors.driver) { %>
              <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                  <%= errors.driver%>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
        <% } %>



          <div class="panel mt-4">
            <div class="table-responsive">
              <table class="table admin-table align-middle">
                <thead>
                  <tr>
                    <th>Driver</th>
                    <th>License No.</th>
                    <th>Phone</th>
                    <th>Assigned Bus</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof drivers !== 'undefined' && drivers && drivers.length > 0) { %>
                    <% drivers.forEach((driver) => { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <img 
                              src="<%= (driver.user && driver.user.profileImage) ? driver.user.profileImage : 'https://via.placeholder.com/40' %>" 
                              alt="<%= driver.user?.name || 'Driver Avatar' %>" 
                              class="rounded-circle object-fit-cover" 
                              width="40" 
                              height="40"
                            />
                            <span class="fw-semibold"><%= driver.user?.name || 'N/A' %></span>
                          </div>
                        </td>
                        <td class="mono"><%= driver.licenseNumber || 'N/A' %></td>
                        <td><%= driver.user?.phone || 'N/A' %></td>
                        <td class="mono">
                          <%= driver.bus?.busNumber || 'Unassigned' %>
                        </td>
                        <td>
                          <% if (driver.dutyStatus === 'on_duty') { %>
                            <span class="badge badge-success">On duty</span>
                          <% } else if (driver.dutyStatus === 'off_duty') { %>
                            <span class="badge badge-muted">Off duty</span>
                          <% } else { %>
                            <span class="badge badge-danger">Suspended</span>
                          <% } %>
                        </td>
                        <td>
                          <button 
                            class="icon-btn-sm edit-driver-btn" 
                            title="Edit Driver"
                            data-bs-toggle="modal" 
                            data-bs-target="#editDriverModal"
                            data-id="<%= driver._id %>"
                            data-name="<%= driver.user?.name || '' %>"
                            data-email="<%= driver.user?.email || '' %>"
                            data-phone="<%= driver.user?.phone || '' %>"
                            data-licensenumber="<%= driver.licenseNumber || '' %>"
                            data-licenseexpiry="<%= driver.licenseExpiry ? new Date(driver.licenseExpiry).toISOString().split('T')[0] : '' %>"
                            data-assignedbusid="<%= driver.bus?._id || '' %>"
                            data-dutystatus="<%= driver.dutyStatus || 'off_duty' %>"
                            data-profileimage="<%= driver.user?.profileImage || '' %>"
                          >
                            <i class="bi bi-pencil"></i>
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="text-center text-muted py-4">No drivers registered yet.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <!-- Modal for Adding Driver -->
    <div
      class="modal fade"
      id="addDriverModal"
      tabindex="-1"
      aria-labelledby="addDriverModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="addDriverModalLabel">
              <i class="bi bi-person-plus me-2 text-brand"></i>Add New Driver
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>

          <form
            action="/web/admin/driver/save"
            method="POST"
            enctype="multipart/form-data"
          >
            <div class="modal-body">
              <div class="row g-3">
                <!-- Driver Profile Image Upload -->
                <div class="col-12 text-center mb-3">
                  <label class="form-label d-block small text-muted fw-semibold">Driver Photo</label>

                  <div class="d-inline-block position-relative">
                    <div
                      class="avatar-preview-wrapper rounded-circle border border-2 border-brand overflow-hidden position-relative mx-auto"
                      style="width: 100px; height: 100px; background-color: #f8f9fa;"
                    >
                      <img
                        id="driverAvatarPreview"
                        src=""
                        alt="Driver Preview"
                        class="w-100 h-100 object-fit-cover d-none"
                      />
                      <div
                        id="avatarPlaceholder"
                        class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted"
                      >
                        <i class="bi bi-camera fs-3"></i>
                        <span style="font-size: 10px">Upload</span>
                      </div>
                    </div>

                    <input
                      type="file"
                      class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer"
                      id="driverImage"
                      name="profileImage"
                      accept="image/*"
                      onchange="previewDriverImage(event)"
                      required
                    />
                  </div>

                  <div class="form-text mt-1">
                    Click circle to upload photo (JPG, PNG, WEBP - Max 3MB)
                  </div>
                </div>

                <!-- Full Name -->
                <div class="col-md-6">
                  <label for="driverName" class="form-label small">Full Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="driverName"
                    name="name"
                    placeholder="e.g. S. Mallick"
                    required
                  />
                </div>

                <!-- Email -->
                <div class="col-md-6">
                  <label for="driverEmail" class="form-label small">Email Address</label>
                  <input
                    type="email"
                    class="form-control"
                    id="driverEmail"
                    name="email"
                    placeholder="driver@busnova.com"
                    required
                  />
                </div>

                <!-- Phone Number -->
                <div class="col-md-6">
                  <label for="driverPhone" class="form-label small">Phone Number</label>
                  <input
                    type="tel"
                    class="form-control"
                    id="driverPhone"
                    name="phone"
                    placeholder="98300 11223"
                    required
                  />
                </div>

                <!-- Account Password -->
                <div class="col-md-6">
                  <label for="driverPassword" class="form-label small">Account Password</label>
                  <input
                    type="password"
                    class="form-control"
                    id="driverPassword"
                    name="password"
                    placeholder="••••••••"
                    required
                  />
                </div>

                <!-- License Number -->
                <div class="col-md-6">
                  <label for="licenseNumber" class="form-label small">License Number</label>
                  <input
                    type="text"
                    class="form-control"
                    id="licenseNumber"
                    name="licenseNumber"
                    placeholder="WB-2291-04"
                    required
                  />
                </div>

                <!-- License Expiry Date -->
                <div class="col-md-6">
                  <label for="licenseExpiry" class="form-label small">License Expiry Date</label>
                  <input
                    type="date"
                    class="form-control"
                    id="licenseExpiry"
                    name="licenseExpiry"
                    required
                  />
                </div>

                <!-- Assign Bus -->
                <div class="col-md-6">
                  <label for="assignedBusId" class="form-label small">Assigned Bus</label>
                  <select
                    class="form-select"
                    id="assignedBusId"
                    name="assignedBusId"
                  >
                    <option value="" selected>Unassigned</option>
                    <% if (typeof findBuses !== 'undefined' && findBuses && findBuses.length > 0) { %>
                      <% findBuses.forEach((bus) => { %>
                        <option value="<%= bus._id %>"><%= bus.busNumber %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Duty Status -->
                <div class="col-md-6">
                  <label for="dutyStatus" class="form-label small">Initial Status</label>
                  <select class="form-select" id="dutyStatus" name="dutyStatus">
                    <option value="off_duty" selected>Off Duty</option>
                    <option value="on_duty">On Duty</option>
                    <option value="suspended">Suspended</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal"
              >
                Cancel
              </button>
              <button type="submit" class="btn btn-brand">
                Save & Add Driver
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Driver Modal -->
    <div
      class="modal fade"
      id="editDriverModal"
      tabindex="-1"
      aria-labelledby="editDriverModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editDriverModalLabel">
              <i class="bi bi-pencil-square me-2 text-brand"></i>Edit Driver Details
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>

          <form
            id="editDriverForm"
            action=""
            method="POST"
            enctype="multipart/form-data"
          >
            <div class="modal-body">
              <div class="row g-3">
                <!-- Profile Image Upload -->
                <div class="col-12 text-center mb-3">
                  <label class="form-label d-block small text-muted fw-semibold">Driver Photo</label>

                  <div class="d-inline-block position-relative">
                    <div
                      class="avatar-preview-wrapper rounded-circle border border-2 border-brand overflow-hidden position-relative mx-auto"
                      style="width: 100px; height: 100px; background-color: #f8f9fa;"
                    >
                      <img
                        id="editDriverAvatarPreview"
                        src=""
                        alt="Driver Preview"
                        class="w-100 h-100 object-fit-cover"
                      />
                      <div
                        id="editAvatarPlaceholder"
                        class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted d-none"
                      >
                        <i class="bi bi-camera fs-3"></i>
                        <span style="font-size: 10px">Upload</span>
                      </div>
                    </div>

                    <input
                      type="file"
                      class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer"
                      id="editDriverImage"
                      name="profileImage"
                      accept="image/*"
                      onchange="previewEditDriverImage(event)"
                    />
                  </div>

                  <div class="form-text mt-1">
                    Click circle to replace photo (Optional)
                  </div>
                </div>

                <!-- Full Name -->
                <div class="col-md-6">
                  <label for="editDriverName" class="form-label small">Full Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="editDriverName"
                    name="name"
                    required
                  />
                </div>

                <!-- Email -->
                <div class="col-md-6">
                  <label for="editDriverEmail" class="form-label small">Email Address</label>
                  <input
                    type="email"
                    class="form-control"
                    id="editDriverEmail"
                    name="email"
                    required
                  />
                </div>

                <!-- Phone Number -->
                <div class="col-md-6">
                  <label for="editDriverPhone" class="form-label small">Phone Number</label>
                  <input
                    type="tel"
                    class="form-control"
                    id="editDriverPhone"
                    name="phone"
                    required
                  />
                </div>

                <!-- License Number -->
                <div class="col-md-6">
                  <label for="editLicenseNumber" class="form-label small">License Number</label>
                  <input
                    type="text"
                    class="form-control"
                    id="editLicenseNumber"
                    name="licenseNumber"
                    required
                  />
                </div>

                <!-- License Expiry Date -->
                <div class="col-md-6">
                  <label for="editLicenseExpiry" class="form-label small">License Expiry Date</label>
                  <input
                    type="date"
                    class="form-control"
                    id="editLicenseExpiry"
                    name="licenseExpiry"
                    required
                  />
                </div>

                <!-- Assign Bus -->
                <div class="col-md-6">
                  <label for="editAssignedBusId" class="form-label small">Assigned Bus</label>
                  <select
                    class="form-select"
                    id="editAssignedBusId"
                    name="assignedBusId"
                  >
                    <option value="">Unassigned</option>
                    <% if (typeof findBuses !== 'undefined' && findBuses && findBuses.length > 0) { %>
                      <% findBuses.forEach((bus) => { %>
                        <option value="<%= bus._id %>"><%= bus.busNumber %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <!-- Duty Status -->
                <div class="col-md-6">
                  <label for="editDutyStatus" class="form-label small">Duty Status</label>
                  <select class="form-select" id="editDutyStatus" name="dutyStatus">
                    <option value="off_duty">Off Duty</option>
                    <option value="on_duty">On Duty</option>
                    <option value="suspended">Suspended</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal"
              >
                Cancel
              </button>
              <button type="submit" class="btn btn-brand">
                Update Driver
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/admin_dashboard.js"></script>

    <script>
      function previewDriverImage(event) {
        const input = event.target;
        const preview = document.getElementById('driverAvatarPreview');
        const placeholder = document.getElementById('avatarPlaceholder');

        if (input.files && input.files[0]) {
          const reader = new FileReader();

          reader.onload = function (e) {
            preview.src = e.target.result;
            preview.classList.remove('d-none');
            placeholder.classList.add('d-none');
          };

          reader.readAsDataURL(input.files[0]);
        }
      }

      // Populate Edit Modal Data
      document.querySelectorAll('.edit-driver-btn').forEach(button => {
        button.addEventListener('click', function () {
          const driverId = this.getAttribute('data-id');
          const form = document.getElementById('editDriverForm');
          form.action = `/web/admin/driver/update/${driverId}`;

          document.getElementById('editDriverName').value = this.getAttribute('data-name');
          document.getElementById('editDriverEmail').value = this.getAttribute('data-email');
          document.getElementById('editDriverPhone').value = this.getAttribute('data-phone');
          document.getElementById('editLicenseNumber').value = this.getAttribute('data-licensenumber');
          document.getElementById('editLicenseExpiry').value = this.getAttribute('data-licenseexpiry');
          document.getElementById('editAssignedBusId').value = this.getAttribute('data-assignedbusid');
          document.getElementById('editDutyStatus').value = this.getAttribute('data-dutystatus');

          const profileImage = this.getAttribute('data-profileimage');
          const preview = document.getElementById('editDriverAvatarPreview');
          const placeholder = document.getElementById('editAvatarPlaceholder');

          if (profileImage) {
            preview.src = profileImage;
            preview.classList.remove('d-none');
            placeholder.classList.add('d-none');
          } else {
            preview.src = '';
            preview.classList.add('d-none');
            placeholder.classList.remove('d-none');
          }
        });
      });

      // Preview replacement image
      function previewEditDriverImage(event) {
        const input = event.target;
        const preview = document.getElementById('editDriverAvatarPreview');
        const placeholder = document.getElementById('editAvatarPlaceholder');

        if (input.files && input.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            preview.src = e.target.result;
            preview.classList.remove('d-none');
            placeholder.classList.add('d-none');
          };
          reader.readAsDataURL(input.files[0]);
        }
      }
    </script>
  </body>
</html>