<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Driver Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="/assets/css/admin_dashboard.css"
    />
    <link
      rel="stylesheet"
      href="/assets/css/driver_dashboard.css"
    />
  </head>

  <body>

    <!-- Sidebar backdrop -->
    <div
      class="sidebar-backdrop"
      id="sidebarBackdrop"
    ></div>

    <!-- DRIVER SIDEBAR -->
    <%- include('../layouts/driver_sidebar') %>
    <div class="admin-main">
      <!-- DRIVER NAVBAR -->
      <%- include('../layouts/driver_navbar') %>

      <main class="admin-content">
        <section class="admin-page">

          <div class="page-head">
            <div>
              <h1>Assigned Trips</h1>
              <p>
                Your trips for today and the days ahead.
              </p>
            </div>

            <a
              href="/web/driver/view/trip/schedule"
              class="btn btn-outline-brand"
            >
              <i class="bi bi-calendar2-week me-1"></i>
              View Full Schedule
            </a>
          </div>

          <div class="row g-3 stat-row">

            <!-- Trips Today -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-orange">
                  <i class="bi bi-bus-front"></i>
                </div>
                <div>

                  <div class="stat-value">
                    <%= todayTrips ? todayTrips.length : 0 %>
                  </div>

                  <div class="stat-label">
                    Trips today
                  </div>
                </div>
              </div>
            </div>

            <!-- Passengers Today -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-ink">
                  <i class="bi bi-people"></i>
                </div>
                <div>
                  <div class="stat-value">
                    <%= todayPassengerCount || 0 %>
                  </div>
                  <div class="stat-label">
                    Passengers today
                  </div>
                </div>
              </div>
            </div>

            <!-- On Time Rate -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-green">
                  <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                  <div class="stat-value">
                    <%= onTimeRate || 0 %>%
                  </div>
                  <div class="stat-label">
                    On-time rate
                  </div>
                </div>
              </div>
            </div>

            <!-- Next Departure -->
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-blue">
                  <i class="bi bi-clock-history"></i>
                </div>
                <div>
                  <div class="stat-value">
                    <% if (nextDeparture) { %>

                      <%= new Date(
                        nextDeparture.departureAt
                      ).toLocaleTimeString(
                        "en-IN",
                        {
                          hour: "2-digit",
                          minute: "2-digit",
                          hour12: false
                        }
                      ) %>
                    <% } else { %>
                      —
                    <% } %>
                  </div>
                  <div class="stat-label">
                    Next departure
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-lg-7">
              <div class="panel">
                <div class="panel-head">
                  <h2>
                    Today's trips
                  </h2>
                </div>

                <div class="table-responsive">

                  <table class="table admin-table align-middle">

                    <thead>
                      <tr>
                        <th>Trip</th>
                        <th>Route</th>
                        <th>Bus</th>
                        <th>Departure</th>
                        <th>Passengers</th>
                        <th>Status</th>
                        <th></th>
                      </tr>
                    </thead>
                    
                    <tbody>
                      <% if (
                        todayTrips &&
                        todayTrips.length > 0
                      ) { %>

                        <% todayTrips.forEach((trip) => { %>
                          <tr>
                            <!-- Trip ID -->

                            <td class="mono">
                              #<%= trip.bookingCode ||
                                  trip.tripCode ||
                                  trip._id.toString().slice(-6).toUpperCase()
                              %>
                            </td>

                            <!-- Route -->

                            <td>
                              <%= trip.route?.originStop?.name ||
                                  trip.route?.origin ||
                                  "Unknown"
                              %>
                              →
                              <%= trip.route?.destinationStop?.name ||
                                  trip.route?.destination ||
                                  "Unknown"
                              %>
                            </td>

                            <!-- Bus -->

                            <td>
                              <%= trip.bus?.busNumber ||
                                  "—"
                              %>
                            </td>

                            <!-- Departure -->

                            <td>
                              <%= new Date(
                                trip.departureAt
                              ).toLocaleTimeString(
                                "en-IN",
                                {
                                  hour: "2-digit",
                                  minute: "2-digit",
                                  hour12: false
                                }
                              ) %>
                            </td>

                            <!-- Passengers -->

                            <td>
                              <%= trip.passengerCount || 0 %>
                              /
                              <%= trip.totalSeats ||
                                  trip.availableSeats ||
                                  "—"
                              %>
                            </td>

                            <!-- Status -->
                            <td>
                              <% if (
                                trip.status === "boarding"
                              ) { %>
                                <span class="badge badge-warning">
                                  Boarding
                                </span>

                              <% } else if (
                                trip.status === "departed"
                              ) { %>

                                <span class="badge badge-success">
                                  Departed
                                </span>

                              <% } else if (
                                trip.status === "completed"
                              ) { %>

                                <span class="badge badge-success">
                                  Completed
                                </span>

                              <% } else if (
                                trip.status === "delayed"
                              ) { %>

                                <span class="badge badge-warning">
                                  Delayed
                                </span>

                              <% } else if (
                                trip.status === "cancelled"
                              ) { %>

                                <span class="badge badge-danger">
                                  Cancelled
                                </span>

                              <% } else { %>

                                <span class="badge badge-muted">
                                  Scheduled
                                </span>

                              <% } %>
                            </td>

                            <!-- Passenger list -->
                            <td>

                              <a
                                class="icon-btn-sm"
                                href="/web/driver/view/passenger/list?trip=<%= trip._id %>"
                                aria-label="View passenger list"
                              >

                                <i class="bi bi-people"></i>

                              </a>
                            </td>
                          </tr>

                        <% }) %>

                      <% } else { %>

                        <!-- NO TRIPS -->
                        <tr>
                          <td
                            colspan="7"
                            class="text-center py-5"
                          >

                            <div class="text-muted">

                              <i
                                class="bi bi-calendar-x"
                                style="font-size: 30px;"
                              ></i>

                              <div class="mt-2">

                                <strong>
                                  No trips scheduled
                                </strong>

                              </div>

                              <small>
                                You don't have any trips assigned for today.
                              </small>

                            </div>
                          </td>
                        </tr>
                      <% } %>

                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <div class="col-lg-5">
              <div class="panel">
                <div class="panel-head">
                  <h2>
                    Next departures
                  </h2>
                </div>

                <ul class="trip-list">

                  <% if (
                    todayTrips &&
                    todayTrips.length > 0
                  ) { %>

                    <% todayTrips.forEach((trip) => { %>
                      <li>

                        <!-- TIME -->
                        <div class="trip-time">

                          <%= new Date(
                            trip.departureAt
                          ).toLocaleTimeString(
                            "en-IN",
                            {
                              hour: "2-digit",
                              minute: "2-digit",
                              hour12: false
                            }
                          ) %>

                        </div>

                        <!-- ROUTE -->
                        <div>
                          <div class="trip-route">
                            <%= trip.route?.originStop?.name ||
                                trip.route?.origin ||
                                "Unknown"
                            %>
                            →
                            <%= trip.route?.destinationStop?.name ||
                                trip.route?.destination ||
                                "Unknown"
                            %>
                          </div>

                          <div class="trip-sub">
                            <%= trip.bus?.busNumber || "—" %>
                            ·
                            <%= trip.passengerCount || 0 %>
                            passengers
                          </div>
                        </div>

                        <!-- STATUS -->
                        <% if (
                          trip.status === "boarding"
                        ) { %>

                          <span class="badge badge-warning">
                            Boarding
                          </span>

                        <% } else if (
                          trip.status === "departed"
                        ) { %>

                          <span class="badge badge-success">
                            Departed
                          </span>

                        <% } else if (
                          trip.status === "delayed"
                        ) { %>

                          <span class="badge badge-warning">
                            Delayed
                          </span>

                        <% } else if (
                          trip.status === "cancelled"
                        ) { %>

                          <span class="badge badge-danger">
                            Cancelled
                          </span>

                        <% } else { %>

                          <span class="badge badge-muted">
                            Scheduled
                          </span>

                        <% } %>
                      </li>

                    <% }) %>

                  <% } else { %>
                    <li class="text-center py-4">
                      <div class="text-muted">
                        <i
                          class="bi bi-clock"
                          style="font-size: 28px;"
                        ></i>
                        <div class="mt-2">
                          <strong>
                            No upcoming departures
                          </strong>
                        </div>
                        <small>
                          You have no trips scheduled for today.
                        </small>
                      </div>
                    </li>
                  <% } %>
                </ul>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/assets/js/driver_dashboard.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const notificationMenu =
          document.getElementById("notificationMenu");

        const notificationDot =
          document.getElementById("notificationDot");

        const socket = io();

        socket.on("connect", () => {
          console.log("Driver socket connected:", socket.id);

          socket.emit("joinUserRoom", "<%= currentUserId %>");

          socket.emit("joinRoleRoom", "Driver");
        });

        socket.on("newNotification", (notification) => {
          console.log("New notification:", notification);

          addNotification(notification);

          if (notificationDot) {
            notificationDot.style.display = "block";
          }
        });

        function addNotification(notification) {

          // Remove "No new notifications"
          const noNotification =
            document.getElementById("noNotificationItem");

          if (noNotification) {
            noNotification.remove();
          }

          const item = document.createElement("li");

          item.className = "notif-item";

          item.innerHTML = `
            <i class="bi bi-bell text-brand"></i>

            <div>
              <strong>${escapeHtml(notification.title)}</strong>

              <span>${escapeHtml(notification.message)}</span>
            </div>
          `;

         notificationMenu.prepend(item);
        }

        function escapeHtml(value) {
          const div = document.createElement("div");

          div.textContent = value;

          return div.innerHTML;
        }
      });
    </script>
  </body>
</html>