<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>BusNova — Payment Failed</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- BusNova CSS -->
  <link
    rel="stylesheet"
    href="/assets/css/admin_dashboard.css"
  />

  <link
    rel="stylesheet"
    href="/assets/css/customer_dashboard.css"
  />

  <style>
    .payment-failed-wrapper {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .payment-failed-card {
      max-width: 600px;
      width: 100%;
      text-align: center;
      padding: 50px 35px;
    }

    .failed-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 25px;
      border-radius: 50%;
      background: #fde2e2;
      color: #dc3545;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
    }

    .payment-failed-card h1 {
      margin-bottom: 12px;
    }

    .payment-failed-message {
      color: #6c757d;
      margin-bottom: 30px;
    }
  </style>
</head>

<body>

  <!-- Sidebar Backdrop -->
  <div
    class="sidebar-backdrop"
    id="sidebarBackdrop"
  ></div>

  <!-- Customer Sidebar -->
  <%- include('../layouts/customer_sidebar') %>

  <div class="admin-main">

    <!-- Customer Navbar -->
    <%- include('../layouts/customer_navbar') %>

    <main class="admin-content">

      <section class="admin-page">

        <div class="payment-failed-wrapper">

          <div class="panel payment-failed-card">

            <!-- Failed Icon -->
            <div class="failed-icon">
              <i class="bi bi-x-lg"></i>
            </div>

            <!-- Heading -->
            <h1>
              Payment Failed
            </h1>

            <!-- Message -->
            <p class="payment-failed-message">
              <%= message || "Payment could not be completed. Please try again." %>
            </p>

            <!-- Buttons -->
            <div class="d-flex justify-content-center gap-3 flex-wrap">

              <a
                href="/web/customer/view/booking/checkout"
                class="btn btn-brand"
              >
                <i class="bi bi-arrow-repeat me-2"></i>
                Try Again
              </a>

              <a
                href="/web/customer/view/upcoming/trip"
                class="btn btn-outline-secondary"
              >
                <i class="bi bi-arrow-left me-2"></i>
                My Trips
              </a>

            </div>

          </div>

        </div>

      </section>

    </main>

  </div>

  <!-- Bootstrap -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

  <!-- Customer Dashboard JS -->
  <script src="/assets/js/customer_dashboard.js"></script>

</body>

</html>