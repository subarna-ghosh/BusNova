<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Customer Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="./admin.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand">
        <span class="brand-mark">B</span>
        <span>BusNova</span>
        <button
          class="sidebar-close d-lg-none"
          id="sidebarClose"
          aria-label="Close menu"
        >
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-group-label">Overview</div>
        <a href="dashboard.html" class="nav-link-item">
          <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>
        <div class="nav-group-label">Fleet</div>
        <a href="buses.html" class="nav-link-item">
          <i class="bi bi-bus-front"></i><span>Bus Management</span>
        </a>
        <a href="seats.html" class="nav-link-item">
          <i class="bi bi-grid-3x3-gap"></i><span>Seat Layout Management</span>
        </a>
        <a href="routes.html" class="nav-link-item">
          <i class="bi bi-signpost-split"></i><span>Route Management</span>
        </a>
        <a href="trips.html" class="nav-link-item">
          <i class="bi bi-calendar2-week"></i><span>Trip Scheduling</span>
        </a>
        <a href="fares.html" class="nav-link-item">
          <i class="bi bi-tag"></i><span>Fare Management</span>
        </a>
        <a href="drivers.html" class="nav-link-item">
          <i class="bi bi-person-badge"></i><span>Driver Management</span>
        </a>
        <div class="nav-group-label">Sales</div>
        <a href="bookings.html" class="nav-link-item">
          <i class="bi bi-ticket-perforated"></i><span>Booking Management</span>
        </a>
        <a href="customers.html" class="nav-link-item active">
          <i class="bi bi-people"></i><span>Customer Management</span>
        </a>
        <a href="coupons.html" class="nav-link-item">
          <i class="bi bi-percent"></i><span>Coupon Management</span>
        </a>
        <a href="payments.html" class="nav-link-item">
          <i class="bi bi-credit-card"></i><span>Payment Management</span>
        </a>
        <div class="nav-group-label">System</div>
        <a href="reports.html" class="nav-link-item">
          <i class="bi bi-bar-chart-line"></i><span>Reports & Analytics</span>
        </a>
        <a href="notifications.html" class="nav-link-item">
          <i class="bi bi-bell"></i><span>Notification Management</span>
        </a>
        <a href="settings.html" class="nav-link-item">
          <i class="bi bi-gear"></i><span>Website Settings</span>
        </a>
      </nav>

      <div class="sidebar-foot">
        <a href="index.html" class="nav-link-item">
          <i class="bi bi-box-arrow-left"></i><span>Back to site</span>
        </a>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <button
          class="icon-btn d-lg-none"
          id="sidebarToggle"
          aria-label="Open menu"
        >
          <i class="bi bi-list"></i>
        </button>

        <div class="topbar-search">
          <i class="bi bi-search"></i>
          <input type="text" placeholder="Search bookings, buses, customers…" />
        </div>

        <div class="topbar-actions">
          <button
            class="icon-btn"
            aria-label="Notifications"
            data-bs-toggle="dropdown"
          >
            <i class="bi bi-bell"></i>
            <span class="icon-dot"></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end notif-menu">
            <li class="notif-item">
              <i class="bi bi-ticket-perforated text-brand"></i>
              <div>
                <strong>New booking</strong
                ><span>Seat 4B on Kolkata → Digha</span>
              </div>
            </li>
            <li class="notif-item">
              <i class="bi bi-exclamation-triangle text-danger"></i>
              <div>
                <strong>Trip delayed</strong
                ><span>BN-04 NV running 20 min late</span>
              </div>
            </li>
            <li class="notif-item">
              <i class="bi bi-cash-coin text-success"></i>
              <div>
                <strong>Payment received</strong
                ><span>₹1,300 for booking #10493</span>
              </div>
            </li>
          </ul>

          <div class="dropdown">
            <button
              class="admin-profile"
              data-bs-toggle="dropdown"
              aria-label="Admin menu"
            >
              <span class="avatar-initials">RA</span>
              <span class="d-none d-md-inline">Riya Agarwal</span>
              <i class="bi bi-chevron-down small"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-person me-2"></i>My profile</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-gear me-2"></i>Account settings</a
                >
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-box-arrow-right me-2"></i>Sign out</a
                >
              </li>
            </ul>
          </div>
        </div>
      </header>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Customer Management</h1>
              <p>Everyone who's booked a BusNova trip.</p>
            </div>
          </div>
          <div class="panel">
            <div class="table-responsive">
              <table class="table admin-table align-middle">
                <thead>
                  <tr>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Bookings</th>
                    <th>Joined</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Rajesh Bahera</td>
                    <td>rajesh.b@example.com</td>
                    <td>90000 11122</td>
                    <td>12</td>
                    <td>Jan 2025</td>
                  </tr>
                  <tr>
                    <td>Anwesha Sen</td>
                    <td>anwesha.s@example.com</td>
                    <td>90000 33344</td>
                    <td>4</td>
                    <td>Mar 2025</td>
                  </tr>
                  <tr>
                    <td>Manoj Kumar</td>
                    <td>manoj.k@example.com</td>
                    <td>90000 55566</td>
                    <td>27</td>
                    <td>Aug 2024</td>
                  </tr>
                  <tr>
                    <td>Sneha Roy</td>
                    <td>sneha.r@example.com</td>
                    <td>90000 77788</td>
                    <td>2</td>
                    <td>Jun 2026</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="./admin.js"></script>
  </body>
</html>
