<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>BusNova — Upcoming Trips</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Dashboard CSS -->
    <link
      rel="stylesheet"
      href="/assets/css/admin_dashboard.css"
    />

    <link
      rel="stylesheet"
      href="/assets/css/customer_dashboard.css"
    />
  </head>

  <body>

    <!-- Sidebar Backdrop -->
    <div
      class="sidebar-backdrop"
      id="sidebarBackdrop"
    ></div>

    <%- include('../layouts/customer_sidebar') %>
    <div class="admin-main">
      <%- include('../layouts/customer_navbar') %>
      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>
                Upcoming Trips
              </h1>
              <p>
                Trips you're booked on that haven't departed yet.
              </p>
            </div>

            <!-- BOOK NEW TRIP -->

            <a
              href="/web/home/view/landing/page"
              class="btn btn-brand"
            >

              <i class="bi bi-plus-lg me-1"></i>

              Book New Trip

            </a>

          </div>


          <!-- =========================================
               UPCOMING TRIPS
          ========================================== -->

          <div class="panel">

            <% if (
              findBooking &&
              findBooking.length > 0
            ) { %>


              <ul class="trip-list trip-list-cards">


                <% findBooking.forEach((list) => { %>


                  <!-- =====================================
                       TRIP ITEM
                  ====================================== -->

                  <li>


                    <!-- =================================
                         DEPARTURE TIME
                    ================================== -->

                    <div class="trip-time">

                      <% if (
                        list.trip &&
                        list.trip.departureAt
                      ) { %>

                        <%= new Date(
                          list.trip.departureAt
                        ).toLocaleTimeString(
                          "en-IN",
                          {
                            hour: "2-digit",
                            minute: "2-digit",
                            hour12: false
                          }
                        ) %>

                      <% } else { %>

                        --

                      <% } %>

                    </div>


                    <!-- =================================
                         TRIP INFORMATION
                    ================================== -->

                    <div>

                      <!-- ROUTE -->

                      <div class="trip-route">

                        <% if (
                          list.originStop &&
                          list.destinationStop
                        ) { %>

                          <%= list.originStop.city ||
                              list.originStop.name ||
                              "Origin" %>

                          <i
                            class="bi bi-arrow-right mx-1"
                          ></i>

                          <%= list.destinationStop.city ||
                              list.destinationStop.name ||
                              "Destination" %>

                        <% } else { %>

                          Route unavailable

                        <% } %>

                      </div>


                      <!-- SUB INFORMATION -->

                      <div class="trip-sub">


                        <!-- Booking code -->

                        <span>

                          <%= list.bookingCode ||
                              "Booking" %>

                        </span>


                        <span class="mx-1">
                          ·
                        </span>


                        <!-- Bus -->

                        <span>

                          <% if (
                            list.trip &&
                            list.trip.bus
                          ) { %>

                            <%= list.trip.bus.busName ||
                                list.trip.bus.registrationNumber ||
                                "Bus" %>

                          <% } else { %>

                            Bus

                          <% } %>

                        </span>


                        <span class="mx-1">
                          ·
                        </span>


                        <!-- Seats -->

                        <span>

                          Seat

                          <% if (
                            Array.isArray(
                              list.seatNumbers
                            ) &&
                            list.seatNumbers.length
                          ) { %>

                            <%= list.seatNumbers.join(", ") %>

                          <% } else { %>

                            N/A

                          <% } %>

                        </span>


                      </div>


                      <!-- DATE -->

                      <div
                        class="text-muted small mt-1"
                      >

                        <i
                          class="bi bi-calendar2-week me-1"
                        ></i>


                        <% if (
                          list.trip &&
                          list.trip.departureAt
                        ) { %>

                          <%= new Date(
                            list.trip.departureAt
                          ).toLocaleDateString(
                            "en-IN",
                            {
                              weekday: "short",
                              day: "2-digit",
                              month: "short",
                              year: "numeric"
                            }
                          ) %>

                        <% } else { %>

                          Date unavailable

                        <% } %>

                      </div>

                    </div>


                    <!-- =================================
                         STATUS
                    ================================== -->

                    <div>


                      <% if (
                        list.bookingStatus ===
                        "confirmed"
                      ) { %>


                        <span
                          class="badge badge-success"
                        >

                          <i
                            class="bi bi-check-circle me-1"
                          ></i>

                          Confirmed

                        </span>


                      <% } else if (
                        list.bookingStatus ===
                        "pending"
                      ) { %>


                        <span
                          class="badge bg-warning text-dark"
                        >

                          <i
                            class="bi bi-clock me-1"
                          ></i>

                          Pending

                        </span>


                      <% } else { %>


                        <span
                          class="badge bg-secondary"
                        >

                          <%= list.bookingStatus ||
                              "Unknown" %>

                        </span>


                      <% } %>


                    </div>


                    <!-- =================================
                         ACTIONS
                    ================================== -->

                    <div class="trip-actions">


                      <!-- VIEW TICKET -->

                      <a
                        class="icon-btn-sm"
                        href="/web/customer/view/payment/summary/<%= list._id %>"
                        aria-label="View ticket"
                        title="View ticket"
                      >

                        <i
                          class="bi bi-eye"
                        ></i>

                      </a>


                      <!-- CANCEL -->

                      <button
                        type="button"
                        class="icon-btn-sm cancel-trip-btn"
                        data-booking-id="<%= list._id %>"
                        aria-label="Cancel trip"
                        title="Cancel trip"
                      >

                        <i
                          class="bi bi-x-lg"
                        ></i>

                      </button>


                    </div>


                  </li>


                <% }) %>


              </ul>


            <% } else { %>


              <!-- =====================================
                   NO UPCOMING TRIPS
              ====================================== -->

              <div
                class="text-center py-5"
              >

                <div class="mb-3">

                  <i
                    class="bi bi-calendar-x fs-1 text-muted"
                  ></i>

                </div>


                <h4>
                  No upcoming trips
                </h4>


                <p class="text-muted mb-4">

                  You don't have any upcoming
                  bus trips at the moment.

                </p>


                <a
                  href="/web/home/view/landing/page"
                  class="btn btn-brand"
                >

                  <i
                    class="bi bi-plus-lg me-1"
                  ></i>

                  Book a Trip

                </a>

              </div>


            <% } %>


          </div>


        </section>

      </main>

    </div>


    <!-- =========================================
         BOOTSTRAP JS
    ========================================== -->

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


    <!-- CUSTOMER DASHBOARD JS -->

    <script
      src="/assets/js/customer_dashboard.js"
    ></script>


    <!-- =========================================
         CANCEL BUTTON
    ========================================== -->

    <script>

      document.addEventListener(
        "DOMContentLoaded",
        () => {

          const cancelButtons =
            document.querySelectorAll(
              ".cancel-trip-btn"
            );


          cancelButtons.forEach(
            (button) => {

              button.addEventListener(
                "click",
                () => {

                  const bookingId =
                    button.dataset.bookingId;


                  const confirmed =
                    confirm(
                      "Are you sure you want to cancel this trip?"
                    );


                  if (!confirmed) {
                    return;
                  }
                  window.location.href =`/web/customer/cancel/booking/${bookingId}`;
                }
              );

            }
          );

        }
      );

    </script>

  </body>
</html>