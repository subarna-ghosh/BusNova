<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BusNova — Create Account</title>

    <!-- Bootstrap 5 & Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Reuses your login.css -->
    <link rel="stylesheet" href="/assets/css/admin_login.css" />
  </head>
  <body>
    <div class="login-shell">
      <!-- Brand Panel (Left Side - Desktop) -->
      <div class="brand-panel d-none d-lg-flex">
        <div class="brand-glow"></div>
        <div class="brand-content">
          <div class="brand-mark-row">
            <span class="brand-mark">B</span>
            <span class="brand-word">BusNova</span>
          </div>

          <h1>Start your next<br />journey today.</h1>
          <p>
            Create a free BusNova customer account to search routes, book seats
            in seconds, and track your trips on the go.
          </p>

          <ul class="role-list">
            <li>
              <i class="bi bi-lightning-charge"></i>Fast & easy online bus
              ticket booking
            </li>
            <li>
              <i class="bi bi-ticket-perforated"></i>Manage, download, or cancel
              tickets easily
            </li>
            <li>
              <i class="bi bi-clock-history"></i>View complete booking history
              and trip details
            </li>
          </ul>
        </div>
      </div>

      <!-- Form Panel (Right Side) -->
      <div class="form-panel">
        <div class="form-wrap">
          <!-- Mobile Header Logo -->
          <div class="mobile-brand d-lg-none">
            <span class="brand-mark">B</span>
            <span class="brand-word">BusNova</span>
          </div>

          <h2>Create Account</h2>
          <p class="subtitle">
            Join BusNova to book tickets and manage your trips.
          </p>

          <!-- Alert Message Box -->
          <div class="alert-box d-none" id="signupError">
            <i class="bi bi-exclamation-circle"></i>
            <span id="signupErrorText"
              >Please fill in all required fields.</span
            >
          </div>

          <form id="signupForm" action="/web/auth/save/register" method="POST" novalidate autocomplete="off">
            <!-- Full Name -->
            <div class="mb-3">
              <label for="signupName" class="form-label small">Full Name</label>
              <input
                type="text"
                name="name"
                class="form-control"
                id="signupName"
                placeholder="e.g. Rahul Das"
                required
              />
              <% if (errors && errors.name) { %>
                      <small class="text-danger">
                          <%= errors.name %>
                      </small>              
              <% } %>
            </div>

            <!-- Email Address -->
            <div class="mb-3">
              <label for="signupEmail" class="form-label small"
                >Email Address</label
              >
              <input
                type="email"
                name="email"
                class="form-control"
                id="signupEmail"
                placeholder="you@example.com"
                required
              />
              <% if (errors && errors.email) { %>
                      <small class="text-danger">
                          <%= errors.email %>
                      </small>
              <% } %>
            </div>

            <!-- Phone Number -->
            <div class="mb-3">
              <label for="signupPhone" class="form-label small"
                >Phone Number</label
              >
              <input
                type="tel"
                name="phone"
                class="form-control"
                id="signupPhone"
                placeholder="e.g. 9830012345"
                required
              />
              <% if (errors && errors.phone) { %>
                      <small class="text-danger">
                          <%= errors.phone %>
                      </small>
              <% } %>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label for="signupPassword" class="form-label small"
                >Password</label
              >
              <div class="password-field">
                <input
                  type="password"
                  name="password"
                  class="form-control"
                  id="signupPassword"
                  placeholder="At least 8 characters"
                  required
                  minlength="8"
                />
                <button
                  type="button"
                  class="password-toggle"
                  id="toggleSignupPassword"
                  aria-label="Show password"
                >
                  <i class="bi bi-eye"></i>
                </button>
              </div>
              <% if (errors && errors.password) { %>
                      <small class="text-danger">
                          <%= errors.password%>
                      </small>
              <% } %>
            </div>

            <!-- Terms Checkbox -->
            <div class="form-check mb-4">
              <input
                class="form-check-input"
                type="checkbox"
                name="agreeTerms"
                value="true"
                id="agreeTerms"
                required
              />
              <label class="form-check-label small text-muted" for="agreeTerms">
                I agree to the
                <a href="#" target="_blank" class="link-brand">Terms of Service</a> and
                <a href="#" target="_blank" class="link-brand">Privacy Policy</a>
              </label>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="btn btn-brand w-100"
              id="signupSubmitBtn"
            >
              Create Account
            </button>
          </form>

          <div class="divider"><span>or</span></div>

          <p class="signup-line">
            Already have an account?
            <a href="/web/auth/view/login" class="link-brand">Sign in here</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Script handling Signup -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>                                             
      document.addEventListener("DOMContentLoaded", () => {
        const toggleBtn = document.getElementById("toggleSignupPassword");
        const passwordInput = document.getElementById("signupPassword");

        // Toggle Password Visibility
        if (toggleBtn && passwordInput) {
          toggleBtn.addEventListener("click", () => {
            const isPassword =
              passwordInput.getAttribute("type") === "password";
            passwordInput.setAttribute(
              "type",
              isPassword ? "text" : "password",
            );

            const icon = toggleBtn.querySelector("i");
            if (icon) {
              icon.classList.toggle("bi-eye", !isPassword);
              icon.classList.toggle("bi-eye-slash", isPassword);
            }
          });
        }
      });

      // Force-clear form input values if loaded fresh or from back-forward cache (bfcache)
window.addEventListener("pageshow", function (event) {
  const form = document.getElementById("signupForm");
  
  // If the navigation was a reload/refresh (PerformanceNavigationTiming) or from cache
  const navEntries = performance.getEntriesByType("navigation");
  const isReload = navEntries.length > 0 && navEntries[0].type === "reload";

  if (event.persisted || isReload) {
    if (form) {
      form.reset(); // Clears native inputs
    }
  }
});
    </script>
  </body>
</html>
