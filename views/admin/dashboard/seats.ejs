<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Seat Layout Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%-include('../../layouts/admin_sidebar')%>

    <div class="admin-main">
      <%-include('../../layouts/admin_navbar')%>

      <main class="admin-content">
        <section class="admin-page">
          <form id="seatLayoutForm" action="/web/admin/seats/save" method="POST">
            <div class="page-head">
              <div>
                <h1>Seat Layout Management</h1>
                <p>Design the seat map once, reuse it across trips.</p>
              </div>
              <button type="submit" class="btn btn-brand">
                <i class="bi bi-save me-1"></i>Save layout
              </button>
            </div>
            
            <% if (success) { %>
              <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                  <i class="bi bi-check-circle-fill me-2"></i>
                  <%= success %>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
              <% } %>

              <% if (errors && errors.layout) { %>
              <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                  <%= errors.layout %>
                  <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="alert"
                  ></button>
              </div>
              <% } %>

            <div class="row g-3">
              <!-- Left Panel: Layout Controls -->
              <div class="col-lg-4">
                <div class="panel">
                  <div class="panel-head"><h2>Layout Settings</h2></div>

                  <div class="mb-3">
                    <label class="form-label small">Layout Name</label>
                    <input
                      type="text"
                      name="name"
                      id="layoutName"
                      class="form-control"
                      placeholder="e.g. Executive 2x2 Sleeper"
                      required
                    />
                  </div>

                  <div class="row g-2 mb-3">
                    <div class="col-6">
                      <label class="form-label small">Rows</label>
                      <input
                        type="number"
                        name="totalRows"
                        id="rowCountInput"
                        class="form-control"
                        value="5"
                        min="1"
                        max="15"
                        required
                      />
                    </div>
                    <div class="col-6">
                      <label class="form-label small">Layout Type</label>
                      <select
                        name="layoutType"
                        id="layoutTypeSelect"
                        class="form-select"
                      >
                        <option value="2x2" selected>2×2 (Seater)</option>
                        <option value="2x1">2×1 (Seater)</option>
                        <option value="sleeper">
                          Sleeper (2x1 Upper/Lower)
                        </option>
                      </select>
                    </div>
                  </div>

                  <!-- Hidden field to hold serialized JSON array of seats -->
                  <input type="hidden" name="seats" id="seatsDataInput" />

                  <div class="p-2 bg-light rounded border small">
                    <strong class="d-block mb-1 text-dark"
                      >Seat Click Guide:</strong
                    >
                    <ul class="mb-0 ps-3 text-muted">
                      <li>
                        <strong>1st Click:</strong> Set as
                        <span class="text-warning font-weight-bold"
                          >Premium</span
                        >
                      </li>
                      <li>
                        <strong>2nd Click:</strong> Turn into
                        <span class="text-danger">Aisle / Empty Gap</span>
                      </li>
                      <li>
                        <strong>3rd Click:</strong> Reset to
                        <span class="text-secondary">Regular Seat</span>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Right Panel: Visual Editor Canvas -->
              <div class="col-lg-8">
                <div class="panel">
                  <div class="panel-head">
                    <h2 id="previewTitle">Layout Preview — 2×2</h2>
                  </div>
                  <div class="seat-editor">
                    <div class="editor-wheel">
                      <i class="bi bi-steering-wheel"></i>
                    </div>

                    <!-- Dynamic Grid Canvas -->
                    <div class="editor-grid" id="seatEditorGrid"></div>

                    <div class="legend mt-3">
                      <span><i class="dot available"></i>Regular seat</span>
                      <span><i class="dot selected"></i>Premium seat</span>
                      <span><i class="dot booked"></i>Aisle / gap</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/admin_dashboard.js"></script>
  </body>
</html>
