<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Admin Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%-include('../../layouts/admin_sidebar')%>

    <div class="admin-main">
      <%-include('../../layouts/admin_navbar')%>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Dashboard</h1>
              <p>Here's how BusNova is running today.</p>
            </div>
            <a href="/web/admin/view/trips" class="btn btn-brand">
              <i class="bi bi-plus-lg me-1"></i>Add Trip
            </a>
          </div>

          <div class="row g-3 stat-row">
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-orange">
                  <i class="bi bi-bus-front"></i>
                </div>
                <div>
                  <div class="stat-value"><%= activeBuses.toLocaleString("en-IN") %></div>
                  <div class="stat-label">Active buses</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-ink">
                  <i class="bi bi-signpost-split"></i>
                </div>
                <div>
                  <div class="stat-value"><%= liveRoutes.toLocaleString("en-IN") %></div>
                  <div class="stat-label">Live routes</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-green">
                  <i class="bi bi-ticket-perforated"></i>
                </div>
                <div>
                  <div class="stat-value"><%= bookingsToday.toLocaleString("en-IN") %></div>
                  <div class="stat-label">Bookings today</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-blue">
                  <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                  <div class="stat-value">₹<%= revenueToday.toLocaleString("en-IN") %></div>
                  <div class="stat-label">Revenue today</div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <!-- booking and revenue -->
            <div class="col-lg-8">
              <div class="panel">
                <div class="panel-head">
                  <h2>Bookings &amp; Revenue</h2>
                  <select id="revenuePeriod" class="form-select form-select-sm w-auto">
                    <option value="7">Last 7 days</option>
                    <option value="30">Last 30 days</option>
                  </select>
                </div>
                <canvas id="revenueChart" height="110"></canvas>
              </div>
            </div>
            <!-- occupany by route -->
            <div class="col-lg-4">
              <div class="panel">
                <div class="panel-head">
                  <h2>Occupancy by route</h2>
                </div>
                <canvas id="occupancyChart" height="170"></canvas>
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-lg-7">
              <div class="panel">
                <div class="panel-head">
                  <h2>Recent bookings</h2>
                  <a href="/web/admin/view/bookings/list" class="link-brand">View all</a>
                </div>
                <div class="table-responsive">
                  <table class="table admin-table align-middle">
                    <thead>
                      <tr>
                        <th>Booking</th>
                        <th>Customer</th>
                        <th>Route</th>
                        <th>Seats</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if ( findBooking && findBooking.length > 0) { %>

                        <% findBooking.forEach((booking) => { %>
                          <tr>
                            <td class="mono"><%= booking.bookingCode || "—" %></td>
                            <td><%= booking.user?.name ||
                              "Unknown Customer" %>
                            </td>
                            <td>
                                <div class="fw-semibold">
                                  <%= booking.originStop?.city ||
                                  booking.originStop?.name ||"Origin" %>
                                  <i class="bi bi-arrow-right mx-1"></i>
                                  <%= booking.destinationStop?.city ||
                                  booking.destinationStop?.name ||
                                  "Destination" %>
                                </div>
                            </td>
                            <td>
                              <% if (Array.isArray(booking.seatNumbers) && booking.seatNumbers.length > 0 ) { %>
                                <span class="mono">
                                  <%= booking.seatNumbers.join(", ") %>
                                </span>
                              <% } else { %>
                               —
                              <% } %>
                            </td>

                           <td>
                              <% if (booking.bookingStatus ==="confirmed") { %>
                              <span class="badge badge-success">
                                <i class="bi bi-check-circle me-1"></i>
                                  Confirmed
                              </span>
                              <% } else if (booking.bookingStatus ==="pending") { %>
                              <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                <i class="bi bi-clock me-1"></i>
                                  Pending
                              </span>
                              <% } else if (booking.bookingStatus ==="cancelled") { %>
                              <span
                                class="badge bg-danger-subtle text-danger border border-danger-subtle"
                              >
                                <i
                                  class="bi bi-x-circle me-1"
                                ></i>
                               Cancelled
                              </span>

                        <% } else if (booking.bookingStatus ==="completed") { %>
                          <span
                            class="badge bg-primary-subtle text-primary border border-primary-subtle"
                          >
                            <i
                              class="bi bi-check2-all me-1"
                            ></i>
                            Completed
                          </span>
                        <% } else { %>
                          <span
                            class="badge bg-secondary"
                          >
                            <%= booking.bookingStatus ||
                                "Unknown" %>
                          </span>
                        <% } %>
                      </td>
                          </tr>
                      <% }) %>

                      <%}else{%>
                        <tr>
                          <td colspan="8" class="text-center py-5">
                            <div class="mb-3">
                              <i
                                class="bi bi-ticket-perforated text-muted"
                                style="font-size: 42px;"
                              ></i>
                            </div>
                            <h5 class="mb-1"> No bookings found</h5>
                            <p class="text-muted mb-0">Customer bookings will appear here.</p>
                            </td>
                        </tr>
                      <%}%>
                
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="panel">
                <div class="panel-head">
                  <h2>Upcoming trips</h2>
                  <a
                    href="/web/admin/view/trips"
                   class="link-brand"
                  >
                    View all
                  </a>
                </div>
                <% if (viewTrips && viewTrips.length > 0) { %>
                  <ul class="trip-list">
                    <% viewTrips.forEach((trip) => { %>
                      <li>
                        <div class="trip-time">
                          <% if (trip.departureAt) { %>

                            <%= new Date(
                              trip.departureAt
                            ).toLocaleTimeString("en-IN", {
                              hour: "2-digit",
                             minute: "2-digit",
                              hour12: false
                            }) %>

                          <% } else { %>
                            --
                          <% } %>

                        </div>
                        <div>
                          <div class="trip-route">
                            <% if (
                              trip.originStop &&
                              trip.destinationStop
                            ) { %>

                              <%= trip.originStop.city ||
                                  trip.originStop.name ||
                                  "Origin" %>

                              <i class="bi bi-arrow-right mx-1"></i>

                             <%= trip.destinationStop.city ||
                                  trip.destinationStop.name ||
                                  "Destination" %>

                            <% } else { %>

                              Route unavailable

                            <% } %>

                          </div>
                          <div class="trip-sub">
                            <% if (trip.bus) { %>
                              <%= trip.bus.busName ||
                                  trip.bus.registrationNumber ||
                                  "Bus" %>
                            <% } else { %>
                              Bus unavailable
                            <% } %>
                            <span class="mx-1">·</span>
                            Driver:
                            <% if (trip.driver) { %>
                              <%= trip.driver.name || "Driver" %>
                            <% } else { %>
                              Not assigned
                            <% } %>
                          </div>
                        </div>
                        <% if (trip.status === "scheduled") { %>
                          <span class="badge badge-muted">
                            Scheduled
                          </span>
                        <% } else if (trip.status === "boarding") { %>
                          <span class="badge badge-warning">
                            Boarding
                          </span>
                        <% } else if (trip.status === "delayed") { %>
                          <span class="badge badge-danger">
                            Delayed
                          </span>
                        <% } else if (trip.status === "departed") { %>
                          <span class="badge bg-secondary">
                            Departed
                          </span>
                        <% } else if (trip.status === "completed") { %>
                          <span class="badge bg-primary">
                            Completed
                          </span>
                        <% } else if (trip.status === "cancelled") { %>
                          <span class="badge badge-danger">
                            Cancelled
                          </span>
                        <% } else { %>
                          <span class="badge bg-secondary">
                            Unknown
                          </span>
                       <% } %>
                      </li>
                    <% }) %>
                  </ul>
                <% } else { %>
                  <div class="text-center py-4">
                    <i
                      class="bi bi-calendar-x text-muted"
                      style="font-size: 32px;"
                    ></i>
                    <h6 class="mt-2 mb-1">
                      No upcoming trips
                    </h6>
                    <p class="text-muted small mb-0">
                      There are no scheduled trips at the moment.
                    </p>
                  </div>
                <% } %>

              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <div
      id="revenueChartData"
      data-revenue='<%= JSON.stringify(revenueChart || []) %>'
      hidden>
    </div>
    <div
      id="occupancyChartData"
      data-occupancy='<%= JSON.stringify(occupancyChart || []) %>'
      hidden
    ></div>
    <script src="/assets/js/admin_dashboard.js"></script>
  </body>
</html>
