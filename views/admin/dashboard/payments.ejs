<!doctype html>
<html lang="en">

<head>

  <meta charset="utf-8" />

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />

  <title>BusNova — Payment Management</title>


  <!-- Bootstrap -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />


  <!-- Bootstrap Icons -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />


  <!-- Google Fonts -->

  <link
    href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />


  <!-- Dashboard CSS -->

  <link
    rel="stylesheet"
    href="/assets/css/admin_dashboard.css"
  />

</head>


<body>


  <!-- Sidebar Backdrop -->

  <div
    class="sidebar-backdrop"
    id="sidebarBackdrop"
  ></div>


  <!-- Sidebar -->

  <%- include('../../layouts/admin_sidebar') %>


  <div class="admin-main">


    <!-- Navbar -->

    <%- include('../../layouts/admin_navbar') %>


    <!-- Main -->

    <main class="admin-content">

      <section class="admin-page">


        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="page-head">

          <div>

            <h1>
              Payment Management
            </h1>

            <p>
              Transactions, refunds and payment activity.
            </p>

          </div>

        </div>


        <!-- =========================================
             STATISTICS
        ========================================== -->

        <div class="row g-3 stat-row">


          <!-- COLLECTED -->

          <div class="col-6 col-lg-4">

            <div class="stat-card">

              <div class="stat-icon bg-green">

                <i class="bi bi-cash-stack"></i>

              </div>

              <div>

                <div class="stat-value">

                  ₹<%= Number(
                    paymentStats?.collectedThisMonth || 0
                  ).toLocaleString("en-IN") %>

                </div>

                <div class="stat-label">

                  Collected this month

                </div>

              </div>

            </div>

          </div>


          <!-- REFUNDS -->

          <div class="col-6 col-lg-4">

            <div class="stat-card">

              <div class="stat-icon bg-orange">

                <i class="bi bi-arrow-counterclockwise"></i>

              </div>

              <div>

                <div class="stat-value">

                  ₹<%= Number(
                    paymentStats?.refundsIssued || 0
                  ).toLocaleString("en-IN") %>

                </div>

                <div class="stat-label">

                  Refunds issued

                </div>

              </div>

            </div>

          </div>


          <!-- PENDING -->

          <div class="col-6 col-lg-4">

            <div class="stat-card">

              <div class="stat-icon bg-blue">

                <i class="bi bi-hourglass-split"></i>

              </div>

              <div>

                <div class="stat-value">

                  ₹<%= Number(
                    paymentStats?.pendingPayments || 0
                  ).toLocaleString("en-IN") %>

                </div>

                <div class="stat-label">

                  Pending payments

                </div>

              </div>

            </div>

          </div>


        </div>


        <!-- =========================================
             PAYMENT TABLE
        ========================================== -->

        <div class="panel mt-1">

          <div class="table-responsive">

            <table class="table admin-table align-middle">


              <!-- TABLE HEADER -->

              <thead>

                <tr>

                  <th>
                    Transaction
                  </th>

                  <th>
                    Customer
                  </th>

                  <th>
                    Booking
                  </th>

                  <th>
                    Amount
                  </th>

                  <th>
                    Method
                  </th>

                  <th>
                    Status
                  </th>

                  <th>
                    Date
                  </th>

                </tr>

              </thead>


              <!-- TABLE BODY -->

              <tbody>


                <% if (
                  listPayment &&
                  listPayment.length > 0
                ) { %>


                  <% listPayment.forEach((val) => { %>


                    <tr>


                      <!-- =================================
                           TRANSACTION
                      ================================== -->

                      <td class="mono">

                        <%= val.razorpayPaymentId ||
                            val.razorpayOrderId ||
                            "—" %>

                      </td>


                      <!-- =================================
                           CUSTOMER
                      ================================== -->

                      <td>

                        <div>

                          <strong>

                            <%= val.customer?.name ||
                                "Unknown Customer" %>

                          </strong>

                          <% if (val.customer?.email) { %>

                            <div class="text-muted small">

                              <%= val.customer.email %>

                            </div>

                          <% } %>

                        </div>

                      </td>


                      <!-- =================================
                           BOOKING
                      ================================== -->

                      <td class="mono">

                        <%= val.booking?.bookingCode ||
                            "—" %>

                      </td>


                      <!-- =================================
                           AMOUNT
                      ================================== -->

                      <td>

                        <strong>

                          ₹<%= Number(
                            val.amount || 0
                          ).toLocaleString(
                            "en-IN",
                            {
                              minimumFractionDigits: 2,
                              maximumFractionDigits: 2
                            }
                          ) %>

                        </strong>

                      </td>


                      <!-- =================================
                           METHOD
                      ================================== -->

                      <td>

                        <% if (val.paymentMethod) { %>

                          <span class="text-capitalize">

                            <%= val.paymentMethod %>

                          </span>

                        <% } else { %>

                          —

                        <% } %>

                      </td>


                      <!-- =================================
                           STATUS
                      ================================== -->

                      <td>


                        <% if (
                          val.status === "captured"
                        ) { %>

                          <span
                            class="badge badge-success"
                          >

                            <i
                              class="bi bi-check-circle me-1"
                            ></i>

                            Captured

                          </span>


                        <% } else if (
                          val.status === "refunded"
                        ) { %>

                          <span
                            class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"
                          >

                            <i
                              class="bi bi-arrow-counterclockwise me-1"
                            ></i>

                            Refunded

                          </span>


                        <% } else if (
                          val.status === "failed"
                        ) { %>

                          <span
                            class="badge bg-danger-subtle text-danger border border-danger-subtle"
                          >

                            <i
                              class="bi bi-x-circle me-1"
                            ></i>

                            Failed

                          </span>


                        <% } else if (
                          val.status === "created"
                        ) { %>

                          <span
                            class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"
                          >

                            <i
                              class="bi bi-clock me-1"
                            ></i>

                            Pending

                          </span>


                        <% } else { %>

                          <span
                            class="badge bg-secondary"
                          >

                            <%= val.status || "Unknown" %>

                          </span>

                        <% } %>


                      </td>


                      <!-- =================================
                           DATE
                      ================================== -->

                      <td>

                        <% if (val.createdAt) { %>

                          <%= new Date(
                            val.createdAt
                          ).toLocaleDateString(
                            "en-IN",
                            {
                              day: "2-digit",
                              month: "short",
                              year: "numeric"
                            }
                          ) %>

                        <% } else { %>

                          —

                        <% } %>

                      </td>


                    </tr>


                  <% }) %>


                <% } else { %>


                  <!-- =================================
                       NO PAYMENTS
                  ================================== -->

                  <tr>

                    <td
                      colspan="7"
                      class="text-center py-5"
                    >

                      <div class="mb-3">

                        <i
                          class="bi bi-receipt-cutoff text-muted"
                          style="font-size: 42px;"
                        ></i>

                      </div>


                      <h5 class="mb-1">

                        No payment transactions

                      </h5>


                      <p class="text-muted mb-0">

                        Payment transactions will appear
                        here once customers make bookings.

                      </p>

                    </td>

                  </tr>


                <% } %>


              </tbody>

            </table>

          </div>

        </div>


      </section>

    </main>


  </div>


  <!-- Bootstrap JS -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>


  <!-- Admin Dashboard JS -->

  <script
    src="/assets/js/admin_dashboard.js"
  ></script>


</body>

</html>