<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Admin Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/admin_dashboard.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%-include('../../layouts/admin_sidebar')%>

    <div class="admin-main">
      <%-include('../../layouts/admin_navbar')%>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Dashboard</h1>
              <p>Here's how BusNova is running today.</p>
            </div>
            <button class="btn btn-brand">
              <i class="bi bi-plus-lg me-1"></i>Add Trip
            </button>
          </div>

          <div class="row g-3 stat-row">
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-orange">
                  <i class="bi bi-bus-front"></i>
                </div>
                <div>
                  <div class="stat-value">92</div>
                  <div class="stat-label">Active buses</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-ink">
                  <i class="bi bi-signpost-split"></i>
                </div>
                <div>
                  <div class="stat-value">54</div>
                  <div class="stat-label">Live routes</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-green">
                  <i class="bi bi-ticket-perforated"></i>
                </div>
                <div>
                  <div class="stat-value">1,284</div>
                  <div class="stat-label">Bookings today</div>
                </div>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <div class="stat-card">
                <div class="stat-icon bg-blue">
                  <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                  <div class="stat-value">₹8.4L</div>
                  <div class="stat-label">Revenue today</div>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-lg-8">
              <div class="panel">
                <div class="panel-head">
                  <h2>Bookings &amp; Revenue</h2>
                  <select class="form-select form-select-sm w-auto">
                    <option>Last 7 days</option>
                    <option>Last 30 days</option>
                  </select>
                </div>
                <canvas id="revenueChart" height="110"></canvas>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="panel">
                <div class="panel-head">
                  <h2>Occupancy by route</h2>
                </div>
                <canvas id="occupancyChart" height="170"></canvas>
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-lg-7">
              <div class="panel">
                <div class="panel-head">
                  <h2>Recent bookings</h2>
                  <a href="bookings.html" class="link-brand">View all</a>
                </div>
                <div class="table-responsive">
                  <table class="table admin-table align-middle">
                    <thead>
                      <tr>
                        <th>Booking</th>
                        <th>Passenger</th>
                        <th>Route</th>
                        <th>Seats</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="mono">#10493</td>
                        <td>Rajesh Bahera</td>
                        <td>Kolkata → Digha</td>
                        <td>2A, 2B</td>
                        <td>
                          <span class="badge badge-success">Confirmed</span>
                        </td>
                      </tr>
                      <tr>
                        <td class="mono">#10492</td>
                        <td>Anwesha Sen</td>
                        <td>Kolkata → Puri</td>
                        <td>1C</td>
                        <td>
                          <span class="badge badge-warning">Pending</span>
                        </td>
                      </tr>
                      <tr>
                        <td class="mono">#10491</td>
                        <td>Manoj Kumar</td>
                        <td>Bangalore → Hyderabad</td>
                        <td>4D</td>
                        <td>
                          <span class="badge badge-success">Confirmed</span>
                        </td>
                      </tr>
                      <tr>
                        <td class="mono">#10490</td>
                        <td>Sneha Roy</td>
                        <td>Kolkata → Siliguri</td>
                        <td>3A</td>
                        <td>
                          <span class="badge badge-danger">Cancelled</span>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="panel">
                <div class="panel-head">
                  <h2>Upcoming trips</h2>
                  <a href="trips.html" class="link-brand">View all</a>
                </div>
                <ul class="trip-list">
                  <li>
                    <div class="trip-time">22:30</div>
                    <div>
                      <div class="trip-route">Kolkata → Digha</div>
                      <div class="trip-sub">BN-04 NV · Driver: S. Mallick</div>
                    </div>
                    <span class="badge badge-success">On time</span>
                  </li>
                  <li>
                    <div class="trip-time">23:00</div>
                    <div>
                      <div class="trip-route">Kolkata → Puri</div>
                      <div class="trip-sub">BN-11 NV · Driver: A. Das</div>
                    </div>
                    <span class="badge badge-warning">Boarding</span>
                  </li>
                  <li>
                    <div class="trip-time">06:15</div>
                    <div>
                      <div class="trip-route">Bangalore → Hyderabad</div>
                      <div class="trip-sub">BN-22 NV · Driver: K. Reddy</div>
                    </div>
                    <span class="badge badge-muted">Scheduled</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="/assets/js/admin_dashboard.js"></script>
  </body>
</html>
