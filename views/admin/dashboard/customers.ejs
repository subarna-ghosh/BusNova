<!doctype html>
<html lang="en">

<head>

  <meta charset="utf-8" />

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />

  <title>BusNova — Customer Management</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet"
  />

  <!-- Dashboard CSS -->
  <link
    rel="stylesheet"
    href="/assets/css/admin_dashboard.css"
  />

</head>


<body>


  <!-- SIDEBAR BACKDROP -->

  <div
    class="sidebar-backdrop"
    id="sidebarBackdrop"
  ></div>


  <!-- ADMIN SIDEBAR -->

  <%- include('../../layouts/admin_sidebar') %>


  <div class="admin-main">


    <!-- ADMIN NAVBAR -->

    <%- include('../../layouts/admin_navbar') %>


    <main class="admin-content">

      <section class="admin-page">


        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="page-head">

          <div>

            <h1>
              Customer Management
            </h1>

            <p>
              View and manage BusNova customers.
            </p>

          </div>

        </div>


        <!-- =========================================
             CUSTOMER TABLE
        ========================================== -->

        <div class="panel">


          <div class="table-responsive">

            <table
              class="table admin-table align-middle"
            >

              <thead>

                <tr>

                  <th>
                    Customer
                  </th>

                  <th>
                    Email
                  </th>

                  <th>
                    Phone
                  </th>

                  <th>
                    Bookings
                  </th>

                  <th>
                    Joined
                  </th>

                </tr>

              </thead>


              <tbody>


                <% if (
                  customers &&
                  customers.length > 0
                ) { %>


                  <% customers.forEach((customer) => { %>


                    <tr>


                      <!-- CUSTOMER -->

                      <td>

                        <div
                          class="d-flex align-items-center gap-2"
                        >

                          <% if (customer.profileImage) { %>

                            <img
                              src="<%= customer.profileImage %>"
                              alt="Profile"
                              class="rounded-circle"
                              style="
                                width: 40px;
                                height: 40px;
                                object-fit: cover;
                              "
                            />

                          <% } else { %>

                            <div
                              class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                              style="
                                width: 40px;
                                height: 40px;
                              "
                            >

                              <i
                                class="bi bi-person text-muted"
                              ></i>

                            </div>

                          <% } %>


                          <strong>
                            <%= customer.name || "Unknown" %>
                          </strong>

                        </div>

                      </td>


                      <!-- EMAIL -->

                      <td>

                        <%= customer.email || "—" %>

                      </td>


                      <!-- PHONE -->

                      <td>

                        <%= customer.phone || "—" %>

                      </td>


                      <!-- BOOKINGS -->

                      <td>

                        <span class="badge badge-success">

                          <%= customer.bookingCount || 0 %>

                        </span>

                      </td>


                      <!-- JOINED -->

                      <td>

                        <% if (customer.createdAt) { %>

                          <%= new Date(
                            customer.createdAt
                          ).toLocaleDateString(
                            "en-IN",
                            {
                              day: "2-digit",
                              month: "short",
                              year: "numeric"
                            }
                          ) %>

                        <% } else { %>

                          —

                        <% } %>

                      </td>


                    </tr>


                  <% }) %>


                <% } else { %>


                  <!-- NO CUSTOMERS -->

                  <tr>

                    <td
                      colspan="5"
                      class="text-center py-5"
                    >

                      <div class="mb-3">

                        <i
                          class="bi bi-people text-muted"
                          style="font-size: 42px;"
                        ></i>

                      </div>

                      <h5>
                        No customers found
                      </h5>

                      <p class="text-muted mb-0">

                        There are currently no registered
                        customers.

                      </p>

                    </td>

                  </tr>


                <% } %>


              </tbody>

            </table>

          </div>

        </div>


      </section>

    </main>

  </div>


  <!-- Bootstrap JS -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>


  <!-- Admin Dashboard JS -->

  <script
    src="/assets/js/admin_dashboard.js"
  ></script>


</body>

</html>