<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BusNova — Bus Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="./admin.css" />
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand">
        <span class="brand-mark">B</span>
        <span>BusNova</span>
        <button
          class="sidebar-close d-lg-none"
          id="sidebarClose"
          aria-label="Close menu"
        >
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-group-label">Overview</div>
        <a href="dashboard.html" class="nav-link-item">
          <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>
        <div class="nav-group-label">Fleet</div>
        <a href="buses.html" class="nav-link-item active">
          <i class="bi bi-bus-front"></i><span>Bus Management</span>
        </a>
        <a href="seats.html" class="nav-link-item">
          <i class="bi bi-grid-3x3-gap"></i><span>Seat Layout Management</span>
        </a>
        <a href="routes.html" class="nav-link-item">
          <i class="bi bi-signpost-split"></i><span>Route Management</span>
        </a>
        <a href="trips.html" class="nav-link-item">
          <i class="bi bi-calendar2-week"></i><span>Trip Scheduling</span>
        </a>
        <a href="fares.html" class="nav-link-item">
          <i class="bi bi-tag"></i><span>Fare Management</span>
        </a>
        <a href="drivers.html" class="nav-link-item">
          <i class="bi bi-person-badge"></i><span>Driver Management</span>
        </a>
        <div class="nav-group-label">Sales</div>
        <a href="bookings.html" class="nav-link-item">
          <i class="bi bi-ticket-perforated"></i><span>Booking Management</span>
        </a>
        <a href="customers.html" class="nav-link-item">
          <i class="bi bi-people"></i><span>Customer Management</span>
        </a>
        <a href="coupons.html" class="nav-link-item">
          <i class="bi bi-percent"></i><span>Coupon Management</span>
        </a>
        <a href="payments.html" class="nav-link-item">
          <i class="bi bi-credit-card"></i><span>Payment Management</span>
        </a>
        <div class="nav-group-label">System</div>
        <a href="reports.html" class="nav-link-item">
          <i class="bi bi-bar-chart-line"></i><span>Reports & Analytics</span>
        </a>
        <a href="notifications.html" class="nav-link-item">
          <i class="bi bi-bell"></i><span>Notification Management</span>
        </a>
        <a href="settings.html" class="nav-link-item">
          <i class="bi bi-gear"></i><span>Website Settings</span>
        </a>
      </nav>

      <div class="sidebar-foot">
        <a href="index.html" class="nav-link-item">
          <i class="bi bi-box-arrow-left"></i><span>Back to site</span>
        </a>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <button
          class="icon-btn d-lg-none"
          id="sidebarToggle"
          aria-label="Open menu"
        >
          <i class="bi bi-list"></i>
        </button>

        <div class="topbar-search">
          <i class="bi bi-search"></i>
          <input type="text" placeholder="Search bookings, buses, customers…" />
        </div>

        <div class="topbar-actions">
          <button
            class="icon-btn"
            aria-label="Notifications"
            data-bs-toggle="dropdown"
          >
            <i class="bi bi-bell"></i>
            <span class="icon-dot"></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end notif-menu">
            <li class="notif-item">
              <i class="bi bi-ticket-perforated text-brand"></i>
              <div>
                <strong>New booking</strong
                ><span>Seat 4B on Kolkata → Digha</span>
              </div>
            </li>
            <li class="notif-item">
              <i class="bi bi-exclamation-triangle text-danger"></i>
              <div>
                <strong>Trip delayed</strong
                ><span>BN-04 NV running 20 min late</span>
              </div>
            </li>
            <li class="notif-item">
              <i class="bi bi-cash-coin text-success"></i>
              <div>
                <strong>Payment received</strong
                ><span>₹1,300 for booking #10493</span>
              </div>
            </li>
          </ul>

          <div class="dropdown">
            <button
              class="admin-profile"
              data-bs-toggle="dropdown"
              aria-label="Admin menu"
            >
              <span class="avatar-initials">RA</span>
              <span class="d-none d-md-inline">Riya Agarwal</span>
              <i class="bi bi-chevron-down small"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-person me-2"></i>My profile</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-gear me-2"></i>Account settings</a
                >
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-box-arrow-right me-2"></i>Sign out</a
                >
              </li>
            </ul>
          </div>
        </div>
      </header>

      <main class="admin-content">
        <section class="admin-page">
          <div class="page-head">
            <div>
              <h1>Bus Management</h1>
              <p>Every bus in your fleet, in one place.</p>
            </div>
            <button
              class="btn btn-brand"
              data-bs-toggle="modal"
              data-bs-target="#addBusModal"
            >
              <i class="bi bi-plus-lg me-1"></i>Add Bus
            </button>
          </div>
          <div class="panel">
            <div class="table-responsive">
              <table class="table admin-table align-middle">
                <thead>
                  <tr>
                    <th>Bus No.</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Amenities</th>
                    <th>Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="busesTableBody">
                  <tr>
                    <td class="mono">BN-04 NV</td>
                    <td>Sleeper A/C</td>
                    <td>32</td>
                    <td>
                      <i class="bi bi-wifi me-1"></i><i class="bi bi-plug"></i>
                    </td>
                    <td><span class="badge badge-success">Active</span></td>
                    <td>
                      <button class="icon-btn-sm">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </td>
                  </tr>
                  <tr>
                    <td class="mono">BN-11 NV</td>
                    <td>2×2 Push-back</td>
                    <td>44</td>
                    <td><i class="bi bi-wifi me-1"></i></td>
                    <td><span class="badge badge-success">Active</span></td>
                    <td>
                      <button class="icon-btn-sm">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </td>
                  </tr>
                  <tr>
                    <td class="mono">BN-22 NV</td>
                    <td>Sleeper A/C</td>
                    <td>30</td>
                    <td>
                      <i class="bi bi-wifi me-1"></i><i class="bi bi-plug"></i>
                    </td>
                    <td>
                      <span class="badge badge-warning">Maintenance</span>
                    </td>
                    <td>
                      <button class="icon-btn-sm">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </td>
                  </tr>
                  <tr>
                    <td class="mono">BN-07 NV</td>
                    <td>2×1 Semi-sleeper</td>
                    <td>36</td>
                    <td><i class="bi bi-plug"></i></td>
                    <td><span class="badge badge-muted">Inactive</span></td>
                    <td>
                      <button class="icon-btn-sm">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <div class="modal fade" id="addBusModal" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Add Bus</h5>
            <button class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label small">Bus number</label
              ><input class="form-control" placeholder="BN-15 NV" />
            </div>
            <div class="mb-3">
              <label class="form-label small">Type</label
              ><select class="form-select">
                <option>Sleeper A/C</option>
                <option>2×2 Push-back</option>
                <option>2×1 Semi-sleeper</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label small">Seat capacity</label
              ><input class="form-control" placeholder="40" />
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-outline-brand" data-bs-dismiss="modal">
              Cancel</button
            ><button class="btn btn-brand">Add bus</button>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="./admin.js"></script>
  </body>
</html>
